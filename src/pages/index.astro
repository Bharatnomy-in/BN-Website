    <Fragment set:html={ticker(s.ticker.map((t) => t.text), {label:"Latest readings from our data", speed:30})} />
  </section>

  <!-- ================================================== CH. I · FIVE LENSES -->
  <section class="ch ch-two" data-sc-act="pan" data-sc-span="4.6" data-chapter="CH. I · FIVE LENSES" aria-labelledby="h-lenses">
    <div class="sc-stage lens-stage" data-sc-stage>
      <div class="lens-rail" data-sc-pan="0.04">
        <div class="rail-item rail-note">
          <p class="display t-l">A heatwave is simultaneously a climate story, an energy story, an agriculture story, and a fiscal story.</p>
          <p class="soft">Research that addresses only one of those threads produces an incomplete answer. Our method puts law, economics, policy and finance in the same room on the same question, from the start.</p>
        </div>
        <Fragment set:html={lensTab({class:"rail-item",n:1,lens:"clm",name:"Climate adaptation & resilience",line:"How India's institutions are, and are not, preparing for a hotter, less predictable future.",focus:['Institutional readiness','Climate risk','Resilience infrastructure'],status:"FIRST DATA PUBLISHED"})} />
        <Fragment set:html={lensTab({class:"rail-item",n:2,lens:"eng",name:"Energy policy & markets",line:"The economics behind India's coal-to-renewables transition, not just the headlines.",focus:['Transition economics','Policy design','Market signals'],status:"IN PREPARATION"})} />
        <Fragment set:html={lensTab({class:"rail-item",n:3,lens:"mac",name:"Macroeconomic health",line:"National growth, inflation, and fiscal capacity, read plainly and traced to primary data.",focus:['Growth','Inflation','Fiscal capacity'],status:"IN PREPARATION"})} />
        <Fragment set:html={lensTab({class:"rail-item",n:4,lens:"eqt",name:"Equity markets",line:"What is actually moving Indian capital markets, and why, separated from market narrative.",focus:['Capital markets','Market drivers','Investor behaviour'],status:"IN PREPARATION"})} />
        <Fragment set:html={lensTab({class:"rail-item",n:5,lens:"com",name:"Commodity markets",line:"The real-economy forces behind commodity prices, not the headline number alone.",focus:['Price formation','Supply dynamics','The real economy'],status:"IN PREPARATION"})} />
