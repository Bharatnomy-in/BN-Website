// The hint: a hand-drawn arrow at the layer buttons, shown on the first scroll steps of the act
const mapHint = () => `<div class="map-hint" data-map-hint aria-hidden="true"><span class="map-hint-text">Switch layers to compare rainfall and air quality</span><svg class="map-hint-arrow" viewBox="0 0 96 70" width="96" height="70"><path class="map-hint-shaft" pathLength="1" d="M6,62 C18,60 34,54 46,42 C58,30 66,20 78,9"/><path class="map-hint-head" pathLength="1" d="M64,8.5 C69,8 74,7.6 79.5,7.2 C78.6,12 78,16.6 77.4,21.5"/></svg></div>`;

const census = (slots: Record<string, string>, o: any = {}) => {
  const width = o.width ?? 640, height = o.height ?? 470, fc = districtsGeo(), frame = frameFor(stateGeo(), width, height, 10), layers = homeLayers();
  const PAPER = '#FBFBF8';
  const outline = sketchDistricts(fc, { frame, roughness: 0.7 });
  const SW = 1200, SH = 150, pad = { l: 44, r: 16, t: 18, b: 26 };
  const built = layers.map((L: any, li: number) => {
    const shaded = L.frames.map((f: any) => sketchDistricts(fc, { frame, values: f.values, range: L.hatchRange, seedSalt: f.first + li * 7, roughness: 0.7 }));
    const colors = Object.fromEntries(outline.map((d: any) => [d.lgd, L.frames.map((f: any) => L.scale.color(f.values[d.lgd]) ?? PAPER)]));
    const nodata = L.nodataLabel ? Object.fromEntries(outline.map((d: any) => [d.lgd, L.frames.map((f: any) => (f.values[d.lgd] == null ? 1 : 0))])) : null;
    const p = L.pen;
    const x = scaleLinear().domain([p.years[0], p.years[p.years.length - 1]]).range([pad.l, SW - pad.r]);
    const y = scaleLinear().domain([p.y0, p.y1]).range([SH - pad.b, pad.t]).nice(3);
    const pen = roughLine(p.years.map((yr: number, i: number) => [x(yr), y(p.mean[i] ?? 0)] as [number, number]), 1951 + li, 0.35);
    const tally = Object.fromEntries(outline.map((d: any) => [d.lgd, { name: d.name, a: L.frames[L.tally.iA]?.values[d.lgd] ?? null, b: L.frames[L.tally.iB]?.values[d.lgd] ?? null }]));
    const client = {
      id: L.id, sliderLabel: L.sliderLabel, aria: L.mapAria,
      frames: L.frames.map((f: any) => ({ label: f.label, first: f.first, last: f.last })),
      colors, nodata, tally, labA: L.tally.labA, labB: L.tally.labB, unit: L.tally.unit, signed: L.tally.signed,
      pen: { years: p.years, mean: p.mean, x0: pad.l, x1: SW - pad.r, y0: y.domain()[0], y1: y.domain()[1], top: pad.t, bottom: SH - pad.b },
    };
    return { L, shaded, x, y, pen, client };
  });
  const first = built[0];
