    return `<div class="strip-layer" data-layer-pen="${L.id}"${hid(li)}><svg viewBox="0 0 ${SW} ${SH}" preserveAspectRatio="none" role="img" aria-label="${escapeHtml(P.aria)}"><defs><clipPath id="pen-clip-${L.id}"><rect x="0" y="0" width="${SW}" height="${SH}" data-pen-clip/></clipPath></defs>${band}${grid}${zero}<line class="trend-axis" x1="${pad.l}" x2="${SW - pad.r}" y1="${SH - pad.b}" y2="${SH - pad.b}"/>${xt}<path class="strip-pen" d="${b.pen}" clip-path="url(#pen-clip-${L.id})"/><g class="strip-nib" data-pen-nib><circle r="4"/><line x1="0" y1="-5" x2="7" y2="-16"/></g></svg><figcaption class="label soft">${escapeHtml(P.caption)}</figcaption><p class="source label census-src">${slots[`src-${L.id}`] ?? ''}</p></div>`;
  };
  return `<div class="census" data-census data-layers='${JSON.stringify(built.map((b: any) => b.client)).replace(/'/g, '&#39;')}'>`
    + `<div class="census-map">`
    + `<div class="census-controls"><p class="census-decade display" aria-live="off" data-decade></p><div class="layer-wrap"><div class="layer-switch" role="group" aria-label="Map layer">${layers.map((L: any, i: number) => `<button type="button" class="layer-btn label" data-layer-btn="${L.id}" aria-pressed="${i === 0}">${escapeHtml(L.button)}</button>`).join('')}</div>${mapHint()}</div></div>`
    + `<svg class="sketch census-svg" viewBox="0 0 ${width} ${height}" preserveAspectRatio="xMinYMid meet" role="img" aria-label="${escapeHtml(first.L.mapAria)}" data-map-svg><defs><pattern id="census-nodata" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="6" stroke="#4C535C" stroke-width="0.8" opacity="0.55"/></pattern></defs>`
    + `<g class="census-fill">${outline.map((d: any) => `<path data-lgd="${d.lgd}" d="${d.plain}"/>`).join('')}</g>`
    + `<g class="census-nodata">${outline.map((d: any) => `<path data-lgd="${d.lgd}" d="${d.plain}" fill="url(#census-nodata)"/>`).join('')}</g>`
    + built.map((b: any, li: number) => `<g class="census-layer" data-layer="${b.L.id}"${hid(li)}>${b.shaded.map((ds: any[], k: number) => `<g class="census-frame" data-frame="${k}">${ds.map((d: any) => (d.hatch.length ? `<path class="sk-hatch" d="${d.hatch.join(' ')}"/>` : '')).join('')}</g>`).join('')}</g>`).join('')
    + `<g class="census-outline" id="census-outline">${outline.map((d: any) => `<g class="sk-d" data-lgd="${d.lgd}"><path class="sk-hit" d="${d.plain}"/><path class="sk-line" d="${d.outline.join(' ')}"/></g>`).join('')}</g></svg>`
    + `<div class="census-tally label" data-tally-card hidden></div>`
    + `<div class="census-ruler"><label class="label" for="census-slider" data-slider-label>${escapeHtml(first.L.sliderLabel)}</label><input id="census-slider" type="range" min="0" max="${first.L.frames.length - 1}" step="1" value="0" data-slider aria-valuetext="${escapeHtml(first.L.frames[0].label)}"/>`
    + built.map((b: any, li: number) => `<ol class="census-ticks label" aria-hidden="true" data-layer-ticks="${b.L.id}"${hid(li)}>${b.L.frames.map((f: any) => `<li>${escapeHtml(b.L.id === 'aqi' ? `’${f.tick.slice(2)}` : f.tick)}</li>`).join('')}</ol>`).join('') + `</div>`
    + `<div class="census-legends">${built.map((b: any, li: number) => `<div data-layer-legend="${b.L.id}"${hid(li)}>${legend({ class: 'census-legend', title: b.L.legendTitle, entries: b.L.scale.legend, nodata: !!b.L.nodataLabel, nodataLabel: b.L.nodataLabel, seed: `census-${b.L.id}` })}</div>`).join('')}</div>`
    + `</div>`
    + `<div class="census-lines">${layers.map((L: any, li: number) => `<div data-layer-lines="${L.id}"${hid(li)}>${slots[L.id] ?? ''}</div>`).join('')}${slots.common ?? ''}</div>`
    + `<figure class="census-strip">${built.map(strip).join('')}</figure>`
    + `</div>`;
};
const pageStats = stats();
// Home (BN-000): chaptered editorial with its scroll interactions contained in this page.
// Copy: bharatnomy.com (live site wins on facts) and CONTENT.md, em dashes removed.
// Every number comes from public/data/stats.json, written by `npm run data`.

const s = stats();
const temp = s.datasets.find((d) => d.slug === 'temperature')!;
const rain = s.datasets.find((d) => d.slug === 'rainfall')!;

// Chapter III timing: must match the frame list in Census.astro and P0/P1 in home.ts
const df = decadeFrames();
const fr = df.decades.filter((d, k, all) => (d.complete || k === all.length - 1) && d.start >= 1960);
const n = fr.length, P0 = 0.12, P1 = 0.9;
const at = (k: number) => +(P0 + (k / n) * (P1 - P0) + 0.01).toFixed(3);
const kLast = fr.findIndex((d) => d.label === s.decade_last);
// "The darkest district on this map": true only if it is darkest on the final frame
const lastI = df.decades.indexOf(fr[n - 1]);
const darkest = Object.entries(df.values).sort((a, b) => (b[1][lastI] ?? -1) - (a[1][lastI] ?? -1))[0][0];
const darkestIsChange = darkest === s.hottest_change_district_lgd;
const span = s.temp_year_span;
const pageTitle = "Bharatnomy";
const pageDescription = "Bharatnomy is an independent research firm studying India's economy layer by layer, state by state, traced to primary data.";

const L3 = homeLayers();
const F = layerFacts(L3);
const atK = (n: number) => (k: number) => +(P0 + (k / n) * (P1 - P0) + 0.01).toFixed(3);
const nR = L3[1].frames.length, atR = atK(nR);
const kRLast = L3[1].frames.findIndex((f: any) => f.tick === F.rain.lastLabel);
const nA = L3[2].frames.length, atA = atK(nA);
const sgn = (v: number) => (v > 0 ? `+${v}` : v < 0 ? `−${Math.abs(v)}` : '0');
const rainSpan = s.rain_last_year - s.rain_first_year + 1;
const censusSlots: Record<string, string> = {
  temperature: [
  `<p class="census-line" data-sc-cue="${at(0)} 1 0.03 0.005">In the ${escapeHtml(s.decade_first)}, the average district had <strong><span class="cnt" data-sc-count="0 ${s.p90_days_first}" data-sc-count-at="${at(0)} ${at(0)+0.06}">${s.p90_days_first}</span><span class="cnt-static">${s.p90_days_first}</span> days</strong> a year hotter than its own 1991 to 2020 normal for that time of year.</p>`,
  `<p class="census-line" data-sc-cue="${at(kLast)} 1 0.03 0.005">By the ${escapeHtml(s.decade_last)}, it had <strong><span class="cnt" data-sc-count="0 ${s.p90_days_last}" data-sc-count-at="${at(kLast)} ${at(kLast)+0.06}">${s.p90_days_last}</span><span class="cnt-static">${s.p90_days_last}</span></strong>.</p>`,
  darkestIsChange
    ? `<p class="census-line" data-sc-cue="${at(n-1)} 1 0.03 0.005">The darkest district on this map, ${escapeHtml(s.hottest_change_district)}, gained <strong><span class="cnt" data-sc-count="0 ${s.hottest_change_days}" data-sc-count-at="${at(n-1)} ${at(n-1)+0.06}">${s.hottest_change_days}</span><span class="cnt-static">${s.hottest_change_days}</span></strong> such days a year.</p>`
    : `<p class="census-line" data-sc-cue="${at(n-1)} 1 0.03 0.005">The biggest gain was in ${escapeHtml(s.hottest_change_district)}: <strong>${s.hottest_change_days}</strong> more such days a year.</p>`,
  `<aside class="mnote census-aside"><span class="label mnote-label">Why this measure</span>Why this measure and not "heat wave days"? A 1-degree grid cell is about 110 km wide, so it smooths out the hottest afternoons. Counting days above each district's own 90th percentile does not depend on absolute thresholds, so it is the fairer way to compare change over time.</aside>`].join(''),
  rainfall: [
    `<p class="census-line" data-sc-cue="${atR(0)} 1 0.03 0.005">In the ${escapeHtml(F.rain.firstLabel)}, the average district's June to September rain ran <strong>${sgn(F.rain.firstAvg)}%</strong> against its own 1971 to 2020 normal.</p>`,
    `<p class="census-line" data-sc-cue="${atR(kRLast)} 1 0.03 0.005">In the ${escapeHtml(F.rain.lastLabel)}, <strong>${sgn(F.rain.lastAvg)}%</strong>.</p>`,
    `<p class="census-line" data-sc-cue="${atR(nR - 1)} 1 0.03 0.005">That decade, <strong>${F.rain.wetterLast}</strong> of ${F.rain.countLast} districts had a wetter monsoon than their normal.</p>`,
  ].join(''),
  aqi: [
    `<p class="census-line" data-sc-cue="${atA(0)} 1 0.03 0.005">In ${F.aqi.firstYear}, CPCB's daily air quality bulletin covered cities in <strong>${F.aqi.monitoredFirst}</strong> of Maharashtra's districts.</p>`,
    `<p class="census-line" data-sc-cue="${atA(nA - 1)} 1 0.03 0.005">By ${F.aqi.lastYear}, <strong>${F.aqi.monitoredLast}</strong>. That year, the average monitored district had AQI above 100 on <strong>${F.aqi.lastAvg}%</strong> of its days.</p>`,
  ].join(''),
  common: [`<p class="census-close" data-sc-cue="0.9 1 0.03 0.005">Every line of shading is a number you can download.</p>`].join(''),
  'src-temperature': `SOURCE: IMD GRIDDED TEMPERATURE, ${s.temp_first_year}–${s.temp_last_year} · <a href="${u('/datasets/temperature')}">DATASET</a> · <a href="${u('/atlas?dataset=temperature&metric=days_tmax_above_p90&view=decade')}">ATLAS</a>`,
  'src-rainfall': `SOURCE: IMD GRIDDED RAINFALL, ${s.rain_first_year}–${s.rain_last_year} · <a href="${u('/datasets/rainfall')}">DATASET</a> · <a href="${u('/atlas?dataset=rainfall&metric=rainfall_jun_sep_departure_pct&view=decade')}">ATLAS</a>`,
  'src-aqi': `SOURCE: CPCB DAILY AQI BULLETINS, ${F.aqi.firstYear}–${F.aqi.lastYear}, POOLED BY DISTRICT (MUMBAI IN BOTH MUMBAI DISTRICTS, PALGHAR IN THANE) · <a href="${DATA_REPO}/tree/${AQI_REF}/${AQI_PATH}">DATA</a>`,
};

