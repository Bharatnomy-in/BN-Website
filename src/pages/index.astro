const indiaSketch = (o:any={}) => { const width=o.width??620,height=o.height??700,cls=o.class??'',thaneId=o.thaneId??'sk-thane',mhId=o.mhId??'sk-mh';const india=indiaGeo(),frame=frameFor(india,width,height,8),states=sketchOutlines(india,frame,{roughness:.55}),mh=districtsGeo(),uniform=Object.fromEntries(mh.features.map((f:any)=>[String(f.properties.lgd),1])),ds=sketchDistricts(mh,{frame,values:uniform,range:[0,1],gap:[4.2,4.2],roughness:.5,hatchWeight:.5}),thane=ds.find((d:any)=>d.name==='Thane'),mhState=states.find((s:any)=>s.props.mapped),cx=ds.reduce((a:number,d:any)=>a+d.x,0)/ds.length,cy=ds.reduce((a:number,d:any)=>a+d.y,0)/ds.length,ring=roughCircle(cx,cy,22,4242);return `<svg class="india ${cls}" viewBox="0 0 ${width} ${height}" role="img" aria-label="Map of India by state. Maharashtra is inked in with its 35 districts; other states are outlines, not yet mapped."><g class="india-states">${states.filter((s:any)=>!s.props.mapped).map((s:any)=>`<path d="${s.d}"><title>${escapeHtml(s.props.name)}: not yet mapped</title></path>`).join('')}</g><g class="india-mh" id="${mhId}"><g class="india-mh-fill">${ds.map((d:any)=>`<path d="${d.plain}"/>`).join('')}</g><g class="india-mh-hatch">${ds.map((d:any)=>`<path d="${d.hatch.join(' ')}"/>`).join('')}</g><g class="india-mh-lines">${ds.map((d:any)=>`<path class="draw" pathLength="1" d="${d.outline.join(' ')}"${d.name==='Thane'?` id="${thaneId}"`:''}><title>${escapeHtml(d.name)}</title></path>`).join('')}</g>${mhState?`<path class="india-mh-edge" d="${mhState.d}"/>`:''}</g><g class="india-wp" id="sk-mh-pt"><circle cx="${cx}" cy="${cy}" r="11" class="wp-fill"/><path d="${ring}" class="wp-ring"/><text x="${cx}" y="${cy+3.5}" text-anchor="middle" class="wp-n">01</text></g>${thane?`<circle cx="${thane.x}" cy="${thane.y}" r="1" fill="none" id="${thaneId}-pt"/>`:''}</svg>`; };
// ===== Ch. III map layers: temperature, rainfall, air quality =====
// Temperature and rainfall by decade (complete decades from the 1960s, then the
// partial last one); air quality by year. Every number comes from public/data/
// (written by `npm run data`) except air quality, which is kept in src/data/
// because `npm run data` rebuilds public/data/ from scratch.
const AQI_PATH = 'states/maharashtra/climate-adaptation/ENV_aqi-days-by-category_2015-to-2026_MH_BNY_DIST';
const AQI_REF = '5ced7f6577ce1abaef9bbc6ce8c41c20de32c687';
const rainDecades = (): DecadeFrames => {
  const m = metricFile('rainfall', 'rainfall_jun_sep_departure_pct');
  const decades: any[] = [];
  for (let start = Math.floor(m.years[0] / 10) * 10; start <= m.years[m.years.length - 1]; start += 10) {
    const ys = m.years.filter((y: number) => y >= start && y < start + 10);
    decades.push({ label: `${start}s`, start, first: ys[0], last: ys[ys.length - 1], years: ys.length, complete: ys.length === 10 });
  }
  const values = Object.fromEntries(Object.entries(m.values).map(([c, v]: any) => [c, decades.map((d) => {
    const xs = m.years.map((y: number, i: number) => (y >= d.first && y <= d.last ? v[i] : null)).filter((x: any) => x != null) as number[];
    return xs.length ? Math.round((xs.reduce((a, b) => a + b, 0) / xs.length) * 100) / 100 : null;
  })]));
  return { metric: 'rainfall_jun_sep_departure_pct', decades, values } as any;
};
const decadeLayerFrames = (df: any) => df.decades
  .map((d: any, i: number) => ({ ...d, i }))
  .filter((d: any, k: number, all: any[]) => (d.complete || k === all.length - 1) && d.start >= 1960)
  .map((d: any) => ({
    label: d.complete ? d.label : `${d.first}–${d.last} · PARTIAL`, tick: d.label, first: d.first, last: d.last,
    values: Object.fromEntries(Object.entries(df.values).map(([k, v]: any) => [k, v[d.i]])),
  }));
const flatVals = (frames: any[]) => frames.flatMap((f) => Object.values(f.values) as (number | null)[]).filter((v): v is number => v != null).sort((a, b) => a - b);
const qAt = (all: number[], p: number) => all[Math.round((all.length - 1) * p)];
const decTicks = (years: number[]) => years.filter((y) => y % 10 === 0);

const homeLayers = () => {
  const s = stats();
  const tf = decadeLayerFrames(decadeFrames()), tAll = flatVals(tf), tm = metricFile('temperature', 'days_tmax_above_p90');
  const temperature = {
    id: 'temperature', button: 'Temperature', sliderLabel: 'Decade', frames: tf,
    scale: classify({ kind: 'warm', breaks: 'quantile', values: tAll, decimals: 0, unit: 'days' } as any),
    legendTitle: 'Unusually hot days a year · decade average', nodataLabel: '',
    hatchRange: [qAt(tAll, 0.05), qAt(tAll, 0.95)],
    pen: { years: tm.years, mean: tm.state_mean, y0: 0, y1: Math.max(...(tm.state_mean as number[])) * 1.08, band: [1991, 2020], zero: false, ticks: decTicks(tm.years),
      caption: 'Days a year above the 1991–2020 90th percentile · 35-district average · shaded band = 1991–2020 normal',
      aria: `Unusually hot days, 35-district average, ${tm.years[0]} to ${tm.years[tm.years.length - 1]}.` },
    tally: { labA: s.decade_first, labB: s.decade_last, iA: tf.findIndex((f: any) => f.label === s.decade_first), iB: tf.findIndex((f: any) => f.label === s.decade_last), unit: 'DAYS', signed: false },
    mapAria: `Maharashtra's districts shaded by unusually hot days, decade by decade from ${tf[0].label} to ${tf[tf.length - 1].label}. Darker colour and denser shading mean more hot days.`,
  };
  const rf = decadeLayerFrames(rainDecades()), rAll = flatVals(rf), rm = metricFile('rainfall', 'rainfall_jun_sep_departure_pct');
  const rAbs = Math.max(...(rm.state_mean!.filter((v: any) => v != null) as number[]).map(Math.abs)) * 1.1;
  const rComplete = rf.filter((f: any) => !f.label.includes('PARTIAL'));
  const rainfall = {
    id: 'rainfall', button: 'Rainfall', sliderLabel: 'Decade', frames: rf,
    scale: classify({ kind: 'wetdry', breaks: 'diverging-symmetric', values: rAll, decimals: 1, unit: '%' } as any),
    legendTitle: 'Monsoon rain vs 1971–2020 normal · decade average', nodataLabel: '',
    hatchRange: [qAt(rAll, 0.05), qAt(rAll, 0.95)],
    pen: { years: rm.years, mean: rm.state_mean, y0: -rAbs, y1: rAbs, band: [1971, 2020], zero: true, ticks: decTicks(rm.years),
      caption: 'June–September rainfall vs each district’s 1971–2020 average, % · 35-district average · shaded band = 1971–2020 normal',
      aria: `Monsoon rainfall departure from normal, 35-district average, ${rm.years[0]} to ${rm.years[rm.years.length - 1]}.` },
    tally: { labA: rComplete[0].tick, labB: rComplete[rComplete.length - 1].tick, iA: 0, iB: rf.indexOf(rComplete[rComplete.length - 1]), unit: '%', signed: true },
    mapAria: `Maharashtra's districts coloured by monsoon rainfall against the 1971 to 2020 normal, decade by decade from ${rf[0].label} to ${rf[rf.length - 1].label}. Brown is drier than normal, teal is wetter. Denser shading means a wetter monsoon.`,
  };
