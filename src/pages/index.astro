    scale: classify({ kind: 'warm', breaks: 'quantile', values: aAll, decimals: 0, unit: '%' } as any),
    legendTitle: 'Share of monitored days with AQI above 100', nodataLabel: 'no monitor',
    hatchRange: [qAt(aAll, 0.05), qAt(aAll, 0.95)],
    pen: { years: a.years, mean: a.state_mean, y0: 0, y1: Math.min(100, aMax * 1.15), band: null, zero: false, ticks: a.years,
      caption: `Share of reported days with AQI above 100, % · average of monitored districts (${a.monitored[0]} in ${a.years[0]}, ${a.monitored[a.monitored.length - 1]} in ${a.years[a.years.length - 1]})`,
      aria: `Share of days with AQI above 100, average of monitored districts, ${a.years[0]} to ${a.years[a.years.length - 1]}.` },
    tally: { labA: String(a.years[0]), labB: String(a.years[a.years.length - 1]), iA: 0, iB: af.length - 1, unit: '% OF DAYS AQI OVER 100', signed: false },
    mapAria: `Maharashtra's districts coloured by the share of days with AQI above 100, year by year from ${a.years[0]} to ${a.years[a.years.length - 1]}. Districts with no monitor in the CPCB bulletin are hatched grey.`,
  };
  return [temperature, rainfall, aqi];
};
const layerFacts = (L: any[]) => {
  const avg = (f: any) => { const v = (Object.values(f.values) as any[]).filter((x) => x != null) as number[]; return v.reduce((s, x) => s + x, 0) / v.length; };
  const rc = L[1].frames.filter((f: any) => !f.label.includes('PARTIAL')), rFirst = rc[0], rLast = rc[rc.length - 1];
  const a: any = aqiFile, aLast = L[2].frames[L[2].frames.length - 1];
  return {
    rain: { firstLabel: rFirst.tick, lastLabel: rLast.tick, firstAvg: Math.round(avg(rFirst)), lastAvg: Math.round(avg(rLast)),
      wetterLast: (Object.values(rLast.values) as any[]).filter((v) => v != null && v > 0).length, countLast: (Object.values(rLast.values) as any[]).filter((v) => v != null).length },
    aqi: { firstYear: a.years[0], lastYear: a.years[a.years.length - 1], years: a.years.length, monitoredFirst: a.monitored[0], monitoredLast: a.monitored[a.monitored.length - 1], lastAvg: Math.round(avg(aLast)) },
