.sk-d.is-selected .sk-hatch { stroke: var(--accent); }
.wp-route { fill: none; stroke: var(--ink); stroke-width: 1; stroke-dasharray: 4 4; }
.wp-fill { fill: var(--paper-raised); }
.wp-ring { fill: none; stroke: var(--ink); stroke-width: 1.2; }
.wp-n { font-family: var(--f-mono); font-size: 9.5px; font-weight: 500; fill: var(--ink); }
.wp-label { font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; fill: var(--ink); paint-order: stroke; stroke: var(--paper); stroke-width: 3px; }

/* ------------------------------------------------------------- TrendChart */
.trendfig { margin: 0; }
.trendfig-cap { margin-bottom: var(--s-2); }
.trendfig-plot svg { width: 100%; height: auto; overflow: visible; }
.trend-grid { stroke: var(--ink-faint); stroke-width: 0.5; stroke-dasharray: 1 3; }
.trend-axis { stroke: var(--ink); stroke-width: 1; }
.trend-zero { stroke: var(--ink); stroke-width: 0.75; }
.trend-tick { font-family: var(--f-mono); font-size: 10px; fill: var(--ink-soft); }
.trend-band { fill: var(--accent-wash); opacity: 0.6; }
.trend-bandlabel { font-family: var(--f-mono); font-size: 9px; letter-spacing: 0.06em; fill: var(--ink-soft); }
.trend-ink { fill: none; stroke: var(--ink); stroke-width: 1.1; stroke-linejoin: round; }
.trend-faint { fill: none; stroke: var(--ink-soft); stroke-width: 1; stroke-linejoin: round; }
.trend-pen { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; }
.trend-roll { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; }
.trend-hl { stroke: var(--accent); stroke-width: 1; stroke-dasharray: 2 2; }
.trend-hllabel { font-family: var(--f-mono); font-size: 10px; fill: var(--accent); font-weight: 500; }
.trend-dot { fill: var(--paper-raised); stroke: var(--accent); stroke-width: 2; }

.source { color: var(--ink-soft); margin-top: var(--s-2); font-size: 0.66rem; line-height: 1.5; text-transform: uppercase; }
.source a { color: var(--accent); }

/* ------------------------------------------------------------------ Legend */
.legend {
  margin: 0; display: inline-block;
  border: var(--hair); background: var(--paper-raised);
  padding: var(--s-3) var(--s-4);
  transform: rotate(var(--tilt, 0deg));
  max-width: 300px;
}
.legend-title { margin-bottom: var(--s-2); }
.legend-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; }
.legend-list li { display: grid; grid-template-columns: 22px 1fr; gap: var(--s-2); align-items: center; }
.legend-list .mono { font-size: 0.75rem; }
.legend-swatch { width: 22px; height: 12px; border: 0.75px solid var(--ink); }
.legend-swatch--nodata { background: repeating-linear-gradient(45deg, var(--paper-raised) 0 2px, var(--ink-soft) 2px 3px); }
.legend-hatch svg { color: var(--ink); }
.legend-range { display: block !important; font-size: 0.75rem !important; margin-top: 2px !important; }
.legend-hatch p { display: flex; justify-content: space-between; gap: var(--s-4); margin-top: var(--s-2); font-size: 0.6rem; }

/* ---------------------------------------------------------- tables (shared) */
.table-wrap { overflow-x: auto; border: var(--hair); background: var(--paper-raised); }
table.dense, .md-table table { width: 100%; border-collapse: collapse; font-size: var(--t-small); }
.dense th, .dense td, .md-table th, .md-table td { text-align: left; padding: 8px 12px; border-bottom: var(--hair-soft); vertical-align: top; }
.dense thead th, .md-table thead th { font-family: var(--f-mono); font-size: var(--t-label); font-weight: 500; letter-spacing: var(--track-label); text-transform: uppercase; border-bottom: var(--hair); background: var(--paper); position: sticky; top: 0; }
.dense th button { all: unset; cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
.dense th button::after { content: "↕"; color: var(--ink-faint); }
.dense th[aria-sort="ascending"] button::after { content: "↑"; color: var(--accent); }
.dense th[aria-sort="descending"] button::after { content: "↓"; color: var(--accent); }
.dense th button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.dense .r { text-align: right; }
.dense code, .lab code { font-family: var(--f-mono); font-size: 0.82em; }
.dense-code { display: block; font-size: 0.72rem; margin-top: 2px; }
.md-table { overflow-x: auto; margin: var(--s-4) 0; border: var(--hair); background: var(--paper-raised); }



/* ===== Inlined from src/styles/home.css ===== */
/* Home (BN-000). Scroll interaction tokens follow the site design system. */
:root {
  --sc-canvas: #F2F3EF;  --sc-surface: #FBFBF8;
  --sc-ink:    #16181C;  --sc-ink-soft: #4C535C;
  --sc-accent: #2346C7;  --sc-accent-ink: #F7F8F4;
  --sc-font-display: "Big Shoulders Display", "Archivo", system-ui, sans-serif;
  --sc-font-text:    "Geist", system-ui, sans-serif;
}

/* the engine's stylesheet also styles body; restate our paper with more weight */
body.home {
  background-color: var(--paper);
  background-image:
    linear-gradient(var(--grid-major) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
    linear-gradient(var(--grid-minor) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-minor) 1px, transparent 1px);
  background-size: var(--grid) var(--grid), var(--grid) var(--grid), 8px 8px, 8px 8px;
  background-position: -1px -1px;
  color: var(--ink);
  font-size: var(--t-body);
  letter-spacing: 0;
}
body.home ::selection { background: var(--accent-wash); color: inherit; }
body.home :focus-visible { border-radius: 0; outline-offset: 2px; }
body.home .btn { color: var(--ink); }
body.home .btn--primary { color: var(--paper); }

.ch { position: relative; }
/* colour pass: chapters sit on lens-tinted paper, grid still showing */
.ch-tint {
  background-color: var(--ch-tint);
  background-image:
    linear-gradient(rgba(22, 24, 28, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(22, 24, 28, 0.045) 1px, transparent 1px);
  background-size: var(--grid) var(--grid);
  border-top: var(--hair); border-bottom: var(--hair);
}
.ch-one { --ch-tint: var(--tint-mac); }
.ch-five { --ch-tint: var(--tint-eng); }
.ch-colophon { --ch-tint: var(--tint-clm); }
.ch-one .india-states path { fill: #F4F7F3; }
.hard li:nth-child(1) .hard-n { color: #E2A08F; } .hard li:nth-child(2) .hard-n { color: var(--lens-eng); }
.hard li:nth-child(3) .hard-n { color: #8FBF9B; } .hard li:nth-child(4) .hard-n { color: #A6BEE3; }
.hard li { border-left: 3px solid transparent; padding-left: var(--s-3); }
.hard li:nth-child(1) { border-left-color: var(--lens-clm); } .hard li:nth-child(2) { border-left-color: var(--lens-eng); }
.hard li:nth-child(3) { border-left-color: var(--lens-mac); } .hard li:nth-child(4) { border-left-color: var(--lens-eqt); }
.five-who div:nth-child(1) { border-top: 4px solid var(--lens-clm); } .five-who div:nth-child(2) { border-top: 4px solid var(--lens-eqt); }
.colophon-line a { color: var(--lens-clm); }
.ch-title, .ch-one, .ch-four, .ch-five, .ch-colophon { padding-block: var(--s-10); }


/* ------------------------------------------------------------ title page */
.ch-title { padding-top: var(--s-8); padding-bottom: 0; overflow-x: clip; --mark-ink: #2346C7; }
/* The Bharatnomy "M", hand-drawn and large, with 15% of it running off the
   right edge. It sits behind the headline, so it stays light. */
.title-mark {
  position: absolute; z-index: 0; pointer-events: none;
  right: 0; top: 45%;
  width: clamp(560px, 64vw, 1120px); height: auto;
  transform: translate(15%, -50%);
  overflow: visible;
}
.title-mark path { fill: none; stroke: var(--mark-ink); stroke-linecap: round; stroke-linejoin: round; }
.title-mark-line { opacity: 0.6; stroke-width: 2.6; }
.title-mark-hatch { opacity: 0.22; stroke-width: 1.3; }
html[data-theme="dark"] .ch-title { --mark-ink: #8FA8F0; }
.js .title-mark { animation: mark-in 1000ms var(--ease-out) 120ms both; }
@keyframes mark-in {
  from { opacity: 0; transform: translate(21%, -50%); }
  to   { opacity: 1; transform: translate(15%, -50%); }
}
@media (prefers-reduced-motion: reduce) { .js .title-mark { animation: none; } }
.ch-title .title-sheet, .ch-title .ticker { position: relative; z-index: 1; }
.title-sheet { row-gap: var(--s-6); padding-bottom: var(--s-9); max-width: 1640px; padding-left: clamp(16px, 2vw, 40px); }
.title-h1 {
  grid-column: 1 / -1; grid-row: 1;
  font-size: clamp(3.4rem, 9.6vw, 11rem); line-height: 0.86; font-weight: 900; letter-spacing: -0.02em;
  margin-left: -0.05em;
}
.title-h1 .ln { display: block; }
.js .title-h1 .ln { animation: ln-rise 760ms var(--ease-out) both; }
.js .title-h1 .ln:nth-child(2) { animation-delay: 90ms; }
@keyframes ln-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
.title-sub { grid-column: 1 / 9; grid-row: 2; display: grid; gap: var(--s-4); align-content: start; }
.title-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-5); margin-top: var(--s-3); }
.panel-note { white-space: nowrap; }

/* -------------------------------------------------------- ch. I · India */
.ch-one { --draw: clamp(0, calc((var(--sc-p, 1) - 0.14) * 3.2), 1); }
.one-sheet { align-items: start; }
.one-text { grid-column: 1 / 6; display: grid; gap: var(--s-5); align-content: start; padding-top: var(--s-8); }
.one-eyebrow { color: var(--ink-soft); }
.one-notes { display: grid; gap: var(--s-6); margin-top: var(--s-6); }
.one-map { grid-column: 7 / 13; margin: 0; position: relative; }
.one-keys { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); align-items: center; margin-top: var(--s-4); }
.india { width: 100%; height: auto; overflow: visible; }
.india-states path { fill: none; stroke: var(--ink-soft); stroke-width: 0.7; opacity: 0.55; stroke-linejoin: round; }
.india-mh-fill path { fill: var(--lens-clm); stroke: none; opacity: calc(0.28 * var(--draw)); }
.india-states path { fill: var(--paper-raised); }
.india-mh-hatch path { fill: none; stroke: var(--ink); stroke-width: 0.5; opacity: calc(0.7 * var(--draw)); }
.india-mh-lines path { fill: none; stroke: var(--ink); stroke-width: 0.8; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--draw)); }
.india-mh-edge { fill: none; stroke: var(--ink); stroke-width: 1.4; stroke-linejoin: round; }
.india-wp { opacity: var(--draw); }

/* --------------------------------------------------- ch. II · five lenses */
.lens-stage { display: flex; align-items: center; }
.lens-rail { display: flex; align-items: stretch; gap: var(--s-7); padding-inline: var(--gutter); }
.rail-item { flex: 0 0 auto; }
.rail-head { width: min(30rem, 82vw); display: grid; gap: var(--s-4); align-content: center; }
.lens-rail .lens { width: min(31rem, 84vw); }
.lens-rail .lens-page { height: 100%; }
.rail-note { width: min(32rem, 82vw); display: grid; gap: var(--s-4); align-content: center; border-left: var(--hair); padding-left: var(--s-6); }

/* ------------------------------------------ ch. III · the hand-shaded census */
.ch-three { --grid-minor: rgba(22, 24, 28, 0.03); --grid-major: rgba(22, 24, 28, 0.075); }
.census-stage {
  background-color: var(--paper-raised);
  background-image:
    linear-gradient(var(--grid-major) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
    linear-gradient(var(--grid-minor) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid-minor) 1px, transparent 1px);
  background-size: var(--grid) var(--grid), var(--grid) var(--grid), 8px 8px, 8px 8px;
  border-top: var(--hair); border-bottom: var(--hair);
}
.census-wrap { max-width: var(--page-max); height: 100%; margin-inline: auto; padding: calc(var(--s-6) + 50px) var(--gutter) var(--s-5); /* 50px: the sticky navbar */ display: grid; grid-template-rows: auto 1fr; gap: var(--s-3); }
.census {
  display: grid; min-height: 0;
  grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  grid-template-rows: minmax(0, 1fr) auto;
  grid-template-areas: "map lines" "strip strip";
  column-gap: var(--s-7); row-gap: var(--s-3);
}
.census-map {
  grid-area: map; position: relative; min-height: 0;
  display: grid; grid-template-columns: minmax(0, 1fr) 210px; grid-template-rows: auto minmax(0, 1fr) auto;
  grid-template-areas: "controls controls" "svg legends" "ruler ruler"; column-gap: var(--s-4);
}
.census-map > .census-controls { grid-area: controls; }
.census-map > .census-svg { grid-area: svg; }
.census-map > .census-ruler { grid-area: ruler; }
.census-map > .census-legends { grid-area: legends; }
.census [hidden] { display: none !important; }
.census-nodata path { opacity: 0; stroke: none; pointer-events: none; }
.census-controls { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: var(--s-2) var(--s-4); min-height: 34px; position: relative; z-index: 2; }
.layer-wrap { position: relative; }
.layer-switch { display: inline-flex; border: var(--hair); background: var(--paper-raised); }
.layer-btn {
  font: inherit; font-size: 0.66rem; letter-spacing: var(--track-label); text-transform: uppercase;
  color: var(--ink); background: transparent; border: 0; padding: 7px 11px; cursor: pointer; min-height: 32px;
}
.layer-btn + .layer-btn { border-left: var(--hair); }
.layer-btn[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
.layer-btn:hover:not([aria-pressed="true"]) { background: var(--accent-wash); }
.layer-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.census-legends { display: grid; gap: var(--s-2); align-content: end; justify-items: stretch; min-height: 0; }
.census-src { margin: 4px 0 0; font-size: 0.6rem; white-space: normal; overflow-wrap: anywhere; max-width: 100%; }
/* the hint: a hand-written note and arrow pointing at the layer buttons */
.map-hint {
  position: absolute; top: 50%; right: calc(100% + 4px); z-index: 3; pointer-events: none;
  display: flex; align-items: center; gap: 0; color: var(--accent);
  opacity: 0; transform: translate(-8px, -50%); transition: opacity 320ms ease, transform 420ms ease;
}
.map-hint-text {
  font-family: var(--f-mono); font-weight: 500; font-size: 0.68rem; letter-spacing: var(--track-label);
  text-transform: uppercase; line-height: 1.35; width: max-content; max-width: 30ch; text-align: right;
  margin: 0; padding: 4px 7px; background: var(--paper-raised); border: 1px solid var(--accent);
}
.map-hint-arrow { flex: none; overflow: visible; width: 56px; height: 40px; transform: rotate(38deg); }
.map-hint-arrow path { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
.map-hint.is-on { opacity: 1; transform: translate(0, -50%); }
.map-hint.is-on .map-hint-shaft { transition: stroke-dashoffset 600ms ease-out 120ms; stroke-dashoffset: 0; }
.map-hint.is-on .map-hint-head { transition: stroke-dashoffset 260ms ease-out 700ms; stroke-dashoffset: 0; }
.census-fill path { fill: transparent; stroke: none; }
.ch-three .census-frame .sk-hatch { stroke: var(--ink); opacity: 0.42; stroke-width: 0.55; }
.census-ruler { display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: var(--s-4); margin-top: var(--s-2); max-width: 640px; }
.census-ruler input[type="range"] { width: 100%; accent-color: var(--accent); height: 28px; cursor: pointer; margin: 0; }
.census-ticks { grid-column: 2; display: flex; justify-content: space-between; list-style: none; margin: 0; padding: 0; font-size: 0.58rem; color: var(--ink-soft); }
.census-ticks li { width: 0; display: flex; justify-content: center; white-space: nowrap; }
.census-ticks li:first-child { justify-content: flex-start; } .census-ticks li:last-child { justify-content: flex-end; }
.census-legend { max-width: 240px; padding: var(--s-2) var(--s-3); }
.census-legend .legend-list .mono { font-size: 0.68rem; }
.census-svg { width: 100%; height: 100%; min-height: 0; max-height: calc(100svh - 360px); }
.census-frame { opacity: 0; }
.census-decade {
  margin: 0 auto 0 0; white-space: nowrap;
  font-family: var(--f-mono); font-weight: 500; font-size: clamp(1.2rem, 0.9rem + 1vw, 1.9rem); letter-spacing: 0.02em;
  border-bottom: 2px solid var(--accent); padding-bottom: 2px; min-height: 1.2em;
}
.census-decade:empty { border-color: transparent; }
.census-outline .sk-d.is-hover .sk-line { stroke: var(--accent); stroke-width: 2; }
.census-tally {
  position: absolute; top: 0; left: 0; z-index: 3; pointer-events: none;
  background: var(--paper-raised); border: var(--hair); padding: 5px 9px; white-space: nowrap;
}
.census-lines { grid-area: lines; display: grid; align-content: start; gap: var(--s-4); padding-top: var(--s-6); }
.census-line { font-size: clamp(1.02rem, 0.95rem + 0.3vw, 1.2rem); line-height: 1.5; max-width: 40ch; }
.census-line strong { font-family: var(--f-display); font-weight: 800; font-size: 1.55em; line-height: 1; color: var(--accent); }
.census-close { font-family: var(--f-display); font-weight: 700; font-size: var(--t-m); line-height: 1.1; max-width: 22ch; }
.census-aside { max-width: 44ch; margin-top: var(--s-3); }
.census-source { margin-top: 0; }
.census-strip { grid-area: strip; margin: 0; }
.census-strip svg { width: 100%; height: 132px; overflow: visible; }
.census-strip figcaption { margin-top: 2px; font-size: 0.62rem; }
.strip-band { fill: var(--accent-wash); opacity: 0.55; }
.strip-pen { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
.strip-nib circle { fill: var(--paper-raised); stroke: var(--accent); stroke-width: 2; vector-effect: non-scaling-stroke; }
.strip-nib line { stroke: var(--accent); stroke-width: 2; vector-effect: non-scaling-stroke; }
.cnt-static { display: none; }

/* ------------------------------------------------------ ch. IV · standards */
.ch-four { border-top: 0; }
.four-sheet { row-gap: var(--s-8); }
.four-title { grid-column: 1 / 11; }
.four-why { grid-column: 1 / 7; display: grid; gap: var(--s-4); align-content: start; }
.four-why p:not(.label) { max-width: 56ch; }
.four-lines { grid-column: 8 / 13; display: grid; gap: var(--s-4); align-content: start; }
.hard { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: var(--hair); }
.hard li { display: grid; grid-template-columns: 44px 1fr; gap: var(--s-3); padding: var(--s-4) 0; border-bottom: var(--hair-soft); }
.hard-n { color: var(--accent); padding-top: 3px; }
.ground-ink .hl-mark path { fill: var(--accent-wash); }
.ground-ink a { color: var(--accent) !important; }

/* ------------------------------------------------------- ch. V · datasets */
.five-sheet { row-gap: var(--s-7); }
.five-head { grid-column: 1 / 8; display: grid; gap: var(--s-5); }
.five-who { grid-column: 9 / 13; margin: 0; display: grid; gap: var(--s-5); align-content: end; }
.five-who div { border-top: var(--hair); padding-top: var(--s-3); }
.five-who dd { margin: var(--s-2) 0 0; font-size: var(--t-small); color: var(--ink-soft); }
.five-tags { grid-column: 1 / -1; position: relative; display: flex; flex-wrap: wrap; gap: var(--s-6) var(--s-5); padding-top: var(--s-7); align-items: flex-start; }
.five-tags .tag { width: 250px; }
.five-string { position: absolute; top: 4px; left: -1%; width: 102%; height: 20px; overflow: visible; }
.five-string path { fill: none; stroke: var(--ink); stroke-width: 1; stroke-dasharray: 5 4; vector-effect: non-scaling-stroke; }
.five-note { grid-column: 1 / 6; }
.five-more { grid-column: 9 / 13; justify-self: end; align-self: end; font-family: var(--f-mono); }

/* --------------------------------------------------------------- colophon */
.ch-colophon { padding-bottom: var(--s-8); }
.colophon-sheet { row-gap: var(--s-5); }
.colophon-line { grid-column: 1 / 11; max-width: 24ch; }
.colophon-sub { grid-column: 1 / 7; max-width: 56ch; }
.colophon-small { grid-column: 1 / -1; display: grid; gap: var(--s-1); margin-top: var(--s-5); border-top: var(--hair-soft); padding-top: var(--s-4); }

/* ----------------------------------------------------------------- mobile */
@media (max-width: 899px) {
  .ch-title, .ch-one, .ch-four, .ch-five, .ch-colophon { padding-block: var(--s-8); }
  .title-h1, .title-sub,
  .one-text, .one-map, .four-title, .four-why, .four-lines,
  .five-head, .five-who, .five-note, .five-more, .colophon-line, .colophon-sub { grid-column: 1 / -1; grid-row: auto; }
  .title-h1 { font-size: clamp(3rem, 15vw, 5rem); }
  .title-mark { display: none; }
  .one-text { padding-top: 0; }
  .one-map { margin-top: var(--s-6); }
  .census-wrap { padding-top: calc(var(--s-5) + 50px); }
  .census { grid-template-columns: 1fr; grid-template-rows: auto auto auto; grid-template-areas: "map" "strip" "lines"; row-gap: var(--s-2); }
  .census-map { display: flex; flex-direction: column; min-height: auto; }
  .census-map > * { flex: none; }
  .census-svg { max-height: 20svh; height: 20svh; }
  .census-strip figcaption { display: none; }
  .census-legends { margin-top: var(--s-2); }
  .census-legend { max-width: none; padding: var(--s-1) var(--s-2); }
  .census-legends .legend-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 0.6rem; }
  .census-controls { justify-content: flex-start; gap: var(--s-2); }
  .census-decade { order: 3; flex-basis: 100%; font-size: 1.05rem; }
  .layer-btn { padding: 6px 7px; font-size: 0.58rem; min-height: 30px; letter-spacing: 0.04em; }
  .census-src { font-size: 0.52rem; }
  .map-hint { top: calc(100% + 2px); right: auto; left: 34%; flex-direction: row-reverse; align-items: flex-start; transform: translateY(6px); }
  .map-hint.is-on { transform: none; }
  .map-hint-arrow { transform: scaleX(-1); width: 64px; height: 50px; }
  .census-decade { margin-top: 0; }
  .map-hint-text { margin-top: 32px; margin-left: 2px; margin-right: 0; font-size: 0.6rem; text-align: left; max-width: 30ch; }
  .census-ticks li:nth-child(even) { visibility: hidden; }
  .census-legend .legend-list { grid-template-columns: 1fr 1fr; }
  .census-strip svg { height: 48px; }
  .census-lines { padding-top: var(--s-2); gap: var(--s-2); }
  .census-line { font-size: 0.95rem; line-height: 1.4; }
  .census-aside, .census-source { display: none; }
  .census-close { display: none; }
  .five-tags { flex-direction: column; align-items: center; }
  .five-string { display: none; }
  .five-tags::before { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; border-left: 1px dashed var(--ink); }
  .five-more { justify-self: start; }
}

/* ---------------------------------------------------------- reduced motion */
@media (prefers-reduced-motion: reduce) {
  .ch-one { --draw: 1; }
  .ch-three { height: auto !important; }
  .census-stage { position: static !important; height: auto !important; }
  .census-svg { max-height: 70vh; }
  .census-fill path { transition: none; }
  .census-line, .census-close { opacity: 1 !important; transform: none !important; }
  .map-hint, .map-hint path { transition: none !important; }
  .cnt { display: none; }
  .cnt-static { display: inline; }
  /* the lens rail becomes an ordinary horizontal scroll region, no held screens */
  .ch-two { height: auto !important; padding-block: var(--s-9); }
  .lens-stage { position: static !important; height: auto !important; padding-block: var(--s-4); }
}


/* ===== Home page scroll interaction styles ===== */
/* ============================================================================
   scrollcraft.css: the taste floor
   ----------------------------------------------------------------------------
   Two layers, and the split matters:

     TOKENS   what you override per brand. Colour roles, the type ramp, the
              spacing scale, elevation, motion. A brand is ~12 values.
     DEVICES  what the engine drives. Do not restyle these to taste; they are
              the mechanism. Style your own markup instead.

   Nothing here draws a "component". There are no card, badge, or pill classes,
   because a stylesheet that ships those is how every page built on it ends up
   with the same shapes. You get a floor and a vocabulary; the composition is
   yours.
   ========================================================================== */

/* ---------------------------------------------------------------- tokens -- */
:root {
  /* --- colour roles. Override these six and the page is rebranded. -------- */
  --sc-canvas:      #08090b;   /* the page ground. Drift interpolates this.   */
  --sc-surface:     #101217;   /* anything raised off the ground             */
  --sc-ink:         #f4f2ef;   /* primary text                               */
  --sc-ink-soft:    #9a9ba1;   /* secondary text. Tinted, never flat gray.   */
  --sc-accent:      #d8ff3e;   /* ONE accent. It owns a region, not confetti. */
  --sc-accent-ink:  #08090b;   /* text that sits on the accent               */

  --sc-hairline:    color-mix(in oklab, var(--sc-ink) 12%, transparent);
  --sc-hairline-strong: color-mix(in oklab, var(--sc-ink) 22%, transparent);

  /* --- type. Two families max. Display carries voice, text carries prose. - */
  --sc-font-display: "Instrument Sans", "Geist", system-ui, sans-serif;
  --sc-font-text:    "Geist", system-ui, sans-serif;
  --sc-font-mono:    "Geist Mono", ui-monospace, monospace;

  /* Fluid ramp. Tracking tightens as size grows because a face set at 6rem
     with 0 tracking reads loose; this is optical correction, not decoration. */
  --sc-t-xs:   clamp(0.75rem, 0.72rem + 0.15vw, 0.82rem);
  --sc-t-sm:   clamp(0.875rem, 0.84rem + 0.18vw, 0.95rem);
  --sc-t-base: clamp(1rem, 0.96rem + 0.22vw, 1.125rem);
  --sc-t-lg:   clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem);
  --sc-t-xl:   clamp(1.6rem, 1.35rem + 1.2vw, 2.25rem);
  --sc-t-2xl:  clamp(2.1rem, 1.6rem + 2.4vw, 3.4rem);
  --sc-t-3xl:  clamp(2.8rem, 1.9rem + 4.2vw, 5rem);
  --sc-t-4xl:  clamp(3.4rem, 1.9rem + 6.6vw, 7.5rem);

  --sc-track-tight:  -0.035em;
  --sc-track-snug:   -0.02em;
  --sc-track-normal: -0.005em;
  --sc-track-wide:    0.08em;

  --sc-leading-none: 0.94;
  --sc-leading-tight: 1.06;
  --sc-leading-body: 1.62;

  --sc-measure: 62ch;

  /* --- space. 4px base: the useful middle steps an 8-only scale misses. --- */
  --sc-1: 0.25rem;  --sc-2: 0.5rem;   --sc-3: 0.75rem;  --sc-4: 1rem;
  --sc-5: 1.5rem;   --sc-6: 2rem;     --sc-7: 3rem;     --sc-8: 4rem;
  --sc-9: 6rem;     --sc-10: 8rem;    --sc-11: 12rem;

  /* Section rhythm is fluid so a phone doesn't inherit desktop air. */
  --sc-section: clamp(4.5rem, 9vw, 11rem);
  --sc-gutter:  clamp(1.25rem, 5vw, 5.5rem);
  --sc-maxw:    82rem;

  /* --- radius. Pick one scale for the page and hold it. ------------------- */
  --sc-r-sm: 6px;  --sc-r-md: 12px;  --sc-r-lg: 20px;  --sc-r-pill: 999px;

  /* --- elevation. Every shadow has an offset AND a soft blur, and is tinted
         to the canvas hue. A zero-offset coloured halo is decoration, not
         depth, so there isn't one here. ---------------------------------- */
  --sc-shadow-color: 220 40% 2%;
  --sc-e1: 0 1px 2px hsl(var(--sc-shadow-color) / 0.28),
           0 2px 6px -1px hsl(var(--sc-shadow-color) / 0.20);
  --sc-e2: 0 2px 4px hsl(var(--sc-shadow-color) / 0.24),
           0 8px 18px -4px hsl(var(--sc-shadow-color) / 0.30);
  --sc-e3: 0 4px 8px hsl(var(--sc-shadow-color) / 0.22),
           0 18px 40px -8px hsl(var(--sc-shadow-color) / 0.38),
           0 48px 90px -24px hsl(var(--sc-shadow-color) / 0.30);

  /* Edge light: a 1px top highlight sells a raised surface better than any
     amount of blur, because real raised things catch light on their lip. */
  --sc-edge: inset 0 1px 0 color-mix(in oklab, var(--sc-ink) 10%, transparent);

  /* --- motion. Built-in CSS easings are too weak for UI. ------------------ */
  --sc-ease-out:    cubic-bezier(0.23, 1, 0.32, 1);
  --sc-ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
  --sc-ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);
  --sc-d-fast: 160ms;  --sc-d-base: 240ms;  --sc-d-slow: 420ms;

  --sc-z-stage: 1; --sc-z-copy: 20; --sc-z-chrome: 60;
}

/* --------------------------------------------------------------- reset -- */
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

body {
  margin: 0;
  background: var(--sc-canvas);
  color: var(--sc-ink);
  font-family: var(--sc-font-text);
  font-size: var(--sc-t-base);
  line-height: var(--sc-leading-body);
  letter-spacing: var(--sc-track-normal);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
  font-synthesis-weight: none;
  overflow-x: clip;
}
img, video, canvas, svg { display: block; max-width: 100%; }
button, input, select, textarea { font: inherit; color: inherit; }

/* ------------------------------------------------- the browser surfaces --
   The parts you did not draw still carry the design. Selection, caret, focus
   ring, scrollbar and tabular numerals all ship with defaults that belong to no
   design system. Theming them is the cheapest signal that a page was built
   rather than assembled, and it is the step that gets skipped most reliably. */
::selection { background: var(--sc-accent); color: var(--sc-accent-ink); }
:root { caret-color: var(--sc-accent); accent-color: var(--sc-accent); }
:focus-visible {
  outline: 2px solid var(--sc-accent);
  outline-offset: 3px;
  border-radius: var(--sc-r-sm);
}
:where(a) { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.22em; }
@supports (scrollbar-color: auto) {
  html { scrollbar-color: color-mix(in oklab, var(--sc-ink) 26%, transparent) transparent; scrollbar-width: thin; }
}
:where(table, .sc-nums, [data-sc-count]) { font-variant-numeric: tabular-nums; }

/* ----------------------------------------------------------- typography -- */
.sc-display {
  font-family: var(--sc-font-display);
  font-weight: 500;
  line-height: var(--sc-leading-none);
  letter-spacing: var(--sc-track-tight);
  text-wrap: balance;
  margin: 0;
}
.sc-display--xl { font-size: var(--sc-t-4xl); }
.sc-display--lg { font-size: var(--sc-t-3xl); }
.sc-display--md { font-size: var(--sc-t-2xl); letter-spacing: var(--sc-track-snug); }
.sc-lede {
  font-size: var(--sc-t-lg);
  line-height: 1.44;
  letter-spacing: var(--sc-track-snug);
  color: var(--sc-ink);
  max-width: 46ch;
  text-wrap: pretty;
  margin: 0;
}
.sc-body { max-width: var(--sc-measure); color: var(--sc-ink-soft); text-wrap: pretty; margin: 0; }
.sc-label {
  font-family: var(--sc-font-mono);
  font-size: var(--sc-t-xs);
  letter-spacing: var(--sc-track-wide);
  text-transform: uppercase;
  color: var(--sc-ink-soft);
}

/* ---------------------------------------------------------------- layout -- */
.sc-wrap { width: 100%; max-width: var(--sc-maxw); margin-inline: auto; padding-inline: var(--sc-gutter); }
.sc-section { padding-block: var(--sc-section); }
/* More space above a heading than below it: the gap belongs to the boundary,
   not to the pair. */
.sc-stack > * + * { margin-top: var(--sc-4); }
.sc-stack > :is(h1,h2,h3) { margin-top: var(--sc-7); }
.sc-stack > :is(h1,h2,h3):first-child { margin-top: 0; }
.sc-rule { height: 1px; border: 0; background: var(--sc-hairline); margin: 0; }

/* =============================================================== DEVICES ==
   Driven by the engine. Restyle your own markup, not these.                */

.sc-act--pinned { position: relative; }
.sc-stage {
  position: sticky; top: 0;
  height: 100vh; height: 100svh;
  overflow: clip;
  z-index: var(--sc-z-stage);
}

/* scrub / sequence media */
.sc-stage :is(video[data-sc-scrub], canvas[data-sc-sequence], .sc-stage__poster) {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
}
video[data-sc-scrub] { opacity: 0; transition: opacity 380ms var(--sc-ease-out); }
.sc-has-clip video[data-sc-scrub] { opacity: 1; }
/* The poster is a live frame-holder, not a placeholder: it stays up until a
   real video frame has painted, which is what stops the blank-stage flash. */
.sc-stage__poster { z-index: 0; transition: opacity 380ms var(--sc-ease-out); }
.sc-has-clip .sc-stage__poster { opacity: 0; }

/* A scrim only where text sits. A full-frame darkening layer flattens the
   image everywhere to fix contrast in one corner. */
.sc-scrim {
  position: absolute; inset: 0; pointer-events: none; z-index: 1;
  background: linear-gradient(
    var(--sc-scrim-angle, 180deg),
    color-mix(in oklab, var(--sc-canvas) var(--sc-scrim-a, 78%), transparent) 0%,
    color-mix(in oklab, var(--sc-canvas) 30%, transparent) 42%,
    transparent 68%);
}
/* Point the scrim at the copy. A scrim gradient that darkens the top while the
   copy sits at the bottom fixes contrast nowhere and flattens the image
   everywhere, which is the most common way text-over-video goes wrong. */
.sc-scrim--bottom { --sc-scrim-angle: 0deg; }
.sc-scrim--left   { --sc-scrim-angle: 90deg; }
.sc-scrim--right  { --sc-scrim-angle: 270deg; }

/* Corner scrims, for copy anchored to a corner. An edge gradient has to darken
   a whole band across the frame to cover one corner; a corner gradient puts the
   density where the text is and leaves the rest of the image alone. Pair with
   .sc-copy--lead / .sc-copy--trail. */
.sc-scrim--lead {
  background: linear-gradient(to top right,
    color-mix(in oklab, var(--sc-canvas) 94%, transparent) 0%,
    color-mix(in oklab, var(--sc-canvas) 72%, transparent) 30%,
    color-mix(in oklab, var(--sc-canvas) 30%, transparent) 52%,
    transparent 72%);
}
.sc-scrim--trail {
  background: linear-gradient(to top left,
    color-mix(in oklab, var(--sc-canvas) 94%, transparent) 0%,
    color-mix(in oklab, var(--sc-canvas) 72%, transparent) 30%,
    color-mix(in oklab, var(--sc-canvas) 30%, transparent) 52%,
    transparent 72%);
}
/* A band across the bottom, for copy that spans the full width of the frame.
   That is what both corner anchors become below 860px, and it is also the right
   shape whenever the copy block is wider than a corner. */
.sc-scrim--band {
  background: linear-gradient(to top,
    color-mix(in oklab, var(--sc-canvas) 94%, transparent) 0%,
    color-mix(in oklab, var(--sc-canvas) 74%, transparent) 22%,
    color-mix(in oklab, var(--sc-canvas) 30%, transparent) 42%,
    transparent 58%);
}
.sc-scrim--vignette {
  background: radial-gradient(120% 90% at 50% 45%, transparent 40%,
              color-mix(in oklab, var(--sc-canvas) 70%, transparent) 100%);
}

/* copy over a stage.
   max-width is in rem, never ch. A `ch` on this container resolves against the
   CONTAINER's font-size (body size), not the display size of the heading inside
   it, so `max-width: 20ch` here silently produces a ~180px column and wraps a
   hero headline to six lines. Set a ch measure on the text element itself. */
.sc-copy {
  position: absolute; z-index: var(--sc-z-copy);
  inset-inline: var(--sc-gutter);
  max-width: min(46rem, 76vw);
  will-change: opacity, transform;
}
.sc-copy--lead   { left: var(--sc-gutter); bottom: clamp(3rem, 12vh, 9rem); }
/* inset-inline FIRST. It is the shorthand for left+right, so declaring it after
   `left: 50%` resets left to auto and the block drifts off the left edge. */
.sc-copy--center { inset-inline: auto; left: 50%; top: 50%; translate: -50% -50%; text-align: center; }
.sc-copy--trail  { inset-inline: auto; right: var(--sc-gutter); bottom: clamp(3rem, 12vh, 9rem); text-align: right; }

/* cue defaults: the engine writes opacity/transform inline, these are the
   pre-paint state so nothing flashes before the first read() */
[data-sc-cue] { opacity: 0; will-change: opacity, transform; }
.sc-ready [data-sc-cue] { transition: none; }

/* kinetic split */
.sc-split { display: inline-block; overflow: hidden; vertical-align: top; }
/* Descenders live below the baseline; a line mask clipped to the line box eats
   the tails off g, y, p, j. The padding buys them room back. */
.sc-split--line { display: block; padding-bottom: 0.14em; margin-bottom: -0.14em; }
.sc-split__i { display: inline-block; will-change: transform, opacity; }
.sc-is-split { opacity: 1 !important; }

/* horizontal rail */
[data-sc-pan] { display: flex; will-change: transform; }

/* reveal + parallax */
[data-sc-reveal] { will-change: clip-path; }
[data-sc-parallax] { will-change: transform; }

/* flow reveal (fires once) */
[data-sc-in], [data-sc-stagger] > * {
  opacity: 0;
  transform: translate3d(0, 14px, 0);
  transition: opacity 620ms var(--sc-ease-out), transform 620ms var(--sc-ease-out);
}
[data-sc-in].sc-in, [data-sc-stagger] > .sc-in { opacity: 1; transform: none; }

/* pointer devices */
[data-sc-tilt] { transform-style: preserve-3d; will-change: transform; }
[data-sc-magnet] { will-change: transform; }
/* isolation always; position only if nothing more specific already set it.
   Written with :where() (zero specificity) on purpose: a plain `position:
   relative` here has the same weight as `.sc-stage` and, being later in the
   file, silently wins. A stage carrying both attributes then stops being
   sticky and the whole act scrolls away instead of pinning. */
[data-sc-spotlight] { isolation: isolate; }
:where([data-sc-spotlight]) { position: relative; }
[data-sc-spotlight]::after {
  content: ""; position: absolute; inset: 0; pointer-events: none; z-index: 2;
  background: radial-gradient(
    28rem 28rem at calc(var(--sc-mx, 0.5) * 100%) calc(var(--sc-my, 0.5) * 100%),
    color-mix(in oklab, var(--sc-accent) 16%, transparent), transparent 70%);
  opacity: 0; transition: opacity var(--sc-d-slow) var(--sc-ease-out);
}
[data-sc-spotlight]:hover::after { opacity: 1; }

/* =========================================================== WORLDFLIGHT ==
   One fixed stage for the whole page. The only thing in document flow is the
   spacer, and it is empty. If you find yourself adding a section here, you want
   act mode instead: the moment a real block scrolls past the fixed stage, the
   page has a seam again and the whole point is gone.                        */

[data-sc-mode="worldflight"] { position: relative; }

.sc-world {
  position: fixed; inset: 0;
  overflow: clip;
  z-index: var(--sc-z-stage);
  background: var(--sc-canvas);
}

/* Every leg is mounted for the life of the page and stacked in the same box.
   The engine owns opacity, visibility and z-index here; do not set them. */
.sc-world__seg {
  position: absolute; inset: 0;
  opacity: 0;
  will-change: opacity;
}
.sc-world__seg > :is(video, img, canvas) {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
}
/* The poster is the frame-holder AND the first camera move: the engine pushes
   it in slowly until a real decoded frame is available to replace it. */
.sc-world__poster {
  z-index: 0;
  transform-origin: 50% 50%;
  transition: opacity 420ms var(--sc-ease-out);
}
.sc-world__seg > video { z-index: 1; }
.sc-world__seg.sc-has-clip .sc-world__poster { opacity: 0; }
/* The act stylesheet lights a clip through its ancestor act. A worldflight leg
   has no act, so match the class the engine also writes on the clip itself. */
video[data-sc-scrub].sc-has-clip { opacity: 1; }

/* The copy layer is fixed too, and inert by default: the engine hands
   pointer-events back to a block only while it is actually legible. */
.sc-world__copy {
  position: fixed; inset: 0;
  z-index: var(--sc-z-copy);
  pointer-events: none;
}
.sc-world__scrim { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
[data-sc-copy] {
  opacity: 0;
  pointer-events: none;
  will-change: opacity, transform;
}
.sc-ready [data-sc-copy] { transition: none; }

/* The track. Empty on purpose. */
.sc-world__spacer { pointer-events: none; }

/* scroll progress */
[data-sc-progress] {
  position: fixed; inset: 0 0 auto 0; height: 2px; z-index: var(--sc-z-chrome);
  background: var(--sc-accent); transform-origin: 0 50%; transform: scaleX(0);
  will-change: transform;
}

/* ----------------------------------------------------------- atmosphere --
   Depth is not only shadow. Grain keeps a flat dark ground from banding, and
   it is the difference between "a dark page" and "a lit room". */
.sc-grain { position: fixed; inset: 0; pointer-events: none; z-index: 3; opacity: 0.045; }
.sc-grain::before {
  content: ""; position: absolute; inset: -50%;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='140' height='140' filter='url(%23n)'/></svg>");
}

/* -------------------------------------------------------- reduced motion -- */
@media (prefers-reduced-motion: reduce) {
  /* Fewer and gentler, not zero. Opacity still carries the reveal so the page
     is comprehensible; every position change is dropped. */
  [data-sc-in], [data-sc-stagger] > * { transform: none; transition-duration: 220ms; }
  [data-sc-parallax], [data-sc-pan], .sc-split__i { transform: none !important; }
  /* A wipe is a position change too. Show reveal content settled. */
  [data-sc-reveal] { clip-path: none !important; }
  /* A rail's transform IS its navigation, not decoration. Zeroing it the way
     parallax and kinetic type are zeroed parks the act on its first screenful
     and makes everything past the fold unreachable: a device degrading into
     missing content. Hand the travel back to the reader as an ordinary scroll
     region instead, so the same items are all still gettable without motion.
     A build that would rather re-lay the rail out as a grid can still do that;
     this is the floor, not the ceiling. */
  [data-sc-act="pan"] .sc-stage,
  [data-sc-act="pan"] [data-sc-stage] {
    overflow-x: auto; overflow-y: hidden;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
  }
  [data-sc-pan] > * { scroll-snap-align: center; }
  [data-sc-spotlight]::after { display: none; }
  /* A worldflight keeps its whole story here. No clip is ever fetched, so the
     posters are the film, and they cross-dissolve through exactly the same
     seams at exactly the same scroll positions. The push-in and the copy drift
     are the only things that go. */
  .sc-world__poster, [data-sc-copy] { transform: none !important; }
}

/* --------------------------------------------------------------- mobile -- */
@media (max-width: 860px) {
  .sc-copy { inset-inline: var(--sc-gutter); max-width: none; }
  .sc-copy--trail { text-align: left; }
  .sc-stage { height: 100svh; }
  /* .sc-copy--trail re-anchors to the left and spans the full width here, so a
     bottom-RIGHT corner gradient darkens the one corner the copy just left and
     guarantees a contrast failure over any bright clip. Point the density at
     the copy: the same band .sc-scrim--band paints. */
  .sc-scrim--trail {
    background: linear-gradient(to top,
      color-mix(in oklab, var(--sc-canvas) 94%, transparent) 0%,
      color-mix(in oklab, var(--sc-canvas) 74%, transparent) 22%,
      color-mix(in oklab, var(--sc-canvas) 30%, transparent) 42%,
      transparent 58%);
  }
}

</style>