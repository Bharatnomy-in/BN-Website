// One file serves both the dataset index (/datasets) and each report
// (/datasets/temperature, /datasets/rainfall).
export function getStaticPaths() {
  // Astro executes getStaticPaths in its own scope. Read the JSON directly
  // instead of calling the page-local stats() helper from the frontmatter.
  const statsPath = path.join(process.cwd(), 'public', 'data', 'stats.json');
  const datasetStats = JSON.parse(fs.readFileSync(statsPath, 'utf8')) as {
    catalog: { slug: string }[];
  };

  return [
    { params: { slug: undefined } },
    ...datasetStats.catalog.map((dataset) => ({ params: { slug: dataset.slug } })),
  ];
}

const s = stats();
const isIndex = Astro.params.slug == null;
// All datasets (catalog), the five on the hanging line, and this page's entry.
const catalog = s.catalog;
const featured = catalog.filter((c) => c.featured).sort((a, b) => a.featured! - b.featured!);
const cat = catalog.find((c) => c.slug === Astro.params.slug);
// Temperature and rainfall have the full page (map, trend); the rest a README page.
const RICH = ['temperature', 'rainfall'];
const isRich = !!cat && RICH.includes(cat.slug);
// datasets that are also in the Atlas get an "Open in Atlas" button
const inAtlas = !!cat && s.datasets.some((x) => x.slug === cat.slug);
const gr = cat && !isRich ? parseReadme(readme(cat.slug)) : null;
const zipHref = (c: CatalogEntry) => u(`/data/${c.slug}/${c.folder}.zip`);
const themes = [...new Set(catalog.map((c) => c.theme))];

// ===== Dataset graph (index page): datasets linked through what they share =====
// Datasets are the big nodes; themes and source agencies are small hub nodes, like
// tags in a notes graph. A few hand-picked topic links join datasets that are
// worth reading together. Every dataset also shares the LGD district code key.
const AGENCIES: [RegExp, string][] = [
  [/\(IMD\)/, 'IMD'], [/\(CPCB\)/, 'CPCB'], [/\(CEA\)/, 'CEA'], [/\(FSI\)/, 'FSI'],
  [/ESMAP/, 'World Bank · ESMAP'], [/FIRMS/, 'NASA FIRMS'], [/\(WRI\)/, 'WRI'], [/Jal Shakti/, 'Jal Shakti'],
];
const TOPIC_LINKS: [string, string, string][] = [
  ['power-stations', 'power-plants', 'Same plants, owner column in both'],
  ['active-fires', 'forest-cover', 'Fires against the forest they burn'],
  ['wind-resource', 'power-plants', 'Wind potential against built capacity'],
  ['solar-resource', 'power-plants', 'Solar potential against built capacity'],
  ['cyclones', 'rainfall', 'Storms and the rain they bring'],
  ['rainfall', 'rainfall-variability', 'Monsoon totals and their spread'],
  ['temperature', 'air-quality', 'Hot, still days and bad air'],
  ['odf-plus-villages', 'rural-tap-water', 'Sanitation and water, village by village'],
];
const THEME_TONE: Record<string, string> = { Climate: 'clm', Energy: 'eng', Environment: 'mac', 'Water & sanitation': 'eqt' };
const dsGraph = (() => {
  const nodes: any[] = [], links: any[] = [];
  const hub = (id: string, label: string, kind: string) => { if (!nodes.some((n) => n.id === id)) nodes.push({ id, label, kind }); return id; };
  for (const c of catalog) {
    nodes.push({ id: c.slug, kind: 'ds', label: c.title.replace(/ by district$/i, ''), code: c.code, theme: c.theme, tone: THEME_TONE[c.theme] ?? 'com', period: c.period, href: u(`/datasets/${c.slug}`) });
    const th = hub(`theme:${c.theme}`, c.theme, 'theme'); nodes.find((n) => n.id === th).tone = THEME_TONE[c.theme] ?? 'com';
    links.push({ s: c.slug, t: th, kind: 'theme' });
    const ag = AGENCIES.find(([re]) => re.test(c.source))?.[1] ?? c.source.split(/[,(]/)[0].trim();
    links.push({ s: c.slug, t: hub(`src:${ag}`, ag, 'src'), kind: 'src' });
  }
  const have = new Set(catalog.map((c) => c.slug));
  for (const [a, b, why] of TOPIC_LINKS) if (have.has(a) && have.has(b)) links.push({ s: a, t: b, kind: 'topic', why });
  return { nodes, links };
})();

// Citations in Chicago style (Chicago Manual of Style, 18th ed.): the dataset
// title in italics and headline-style capitals, version = data commit, date =
// that commit's date, URL = this site's page for the dataset.
const SMALL_WORDS = new Set(['a', 'an', 'the', 'and', 'but', 'or', 'nor', 'for', 'so', 'yet', 'as', 'at', 'by', 'in', 'of', 'on', 'per', 'to', 'up', 'via', 'vs', 'with', 'from', 'into']);
const headline = (t: string) => t.split(' ').map((w, i, all) => {
  if (/[A-Z0-9]/.test(w.slice(1)) || /^\d/.test(w) || w === 'm') return w;              // CO2, ODF, 100, m (unit)
  if (i > 0 && i < all.length - 1 && SMALL_WORDS.has(w.toLowerCase())) return w.toLowerCase();
  return w[0].toUpperCase() + w.slice(1);
}).join(' ');
const chicagoDate = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const pageUrl = (slug: string) => new URL(u(`/datasets/${slug}/`), Astro.site).href;
const chicago = (c: CatalogEntry) => {
  const title = `${headline(c.title)}, Maharashtra`;
  const year = s.data.date.slice(0, 4), date = chicagoDate(s.data.date), url = pageUrl(c.slug);
  const t = (x: string) => `<cite>${escapeHtml(x)}</cite>`;
  const src = c.source.split(/[,(]/)[0].trim();
  return {
    bib: `Bharatnomy. ${t(title)}. Dataset ${c.code}, version ${s.data.short}. Bharatnomy, ${date}. ${url}.`,
    note: `Bharatnomy, ${t(title)}, dataset ${c.code}, version ${s.data.short} (Bharatnomy, ${date}), ${url}.`,
    short: `Bharatnomy, ${t(headline(c.title))}.`,
    ref: `Bharatnomy. ${year}. ${t(title)}. Dataset ${c.code}, version ${s.data.short}. Bharatnomy. ${url}.`,
    intext: `(Bharatnomy ${year})`,
    src,
  };
};
const citeBlock = (c: CatalogEntry, id: string) => {
  const k = chicago(c);
  const row = (label: string, html: string) => `<div class="cite-row"><p class="label soft">${label}</p><p class="cite-text" data-cite>${html}</p><button type="button" class="cite-copy label" data-cite-copy>Copy</button></div>`;
  return `<div class="cite" id="${id}">
    <p class="label cite-style">Chicago style · notes and bibliography</p>
    ${row('Bibliography', k.bib)}
    ${row('First note', `1. ${k.note}`)}
    ${row('Later notes', `2. ${k.short}`)}
    <p class="label cite-style">Chicago style · author-date</p>
    ${row('Reference list', k.ref)}
    ${row('In the text', k.intext)}
    <p class="soft cite-foot">The figures come from ${escapeHtml(k.src)}; when your argument rests on them, cite that source too. Licence: CC BY 4.0.</p>
  </div>`;
};

// The fallback is used only while rendering the listing route. The detail
