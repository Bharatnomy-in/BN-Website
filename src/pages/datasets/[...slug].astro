<script is:inline>
// Dataset graph: a small force layout (repulsion, springs, a pull to the centre),
// drawn in SVG. Hover or focus a node to light up its neighbours; drag to move.
(() => {
  const root = document.querySelector('[data-dsx-graph]');
  if (!root) return;
  const NS = 'http://www.w3.org/2000/svg';
  const data = JSON.parse(root.querySelector('[data-graph-data]').textContent);
  const svg = root.querySelector('[data-graph-svg]'), gL = svg.querySelector('[data-graph-links]'), gN = svg.querySelector('[data-graph-nodes]');
  const tip = root.querySelector('[data-graph-tip]');
  const W = 1200, H = 620, reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const byId = new Map();
  const R = { ds: 13, theme: 8, src: 5 };
  data.nodes.forEach((n, i) => {
    const a = i * 2.39996, r = 40 + 9 * i; // golden-angle spiral start, so every load settles the same way
    Object.assign(n, { x: W / 2 + r * Math.cos(a), y: H / 2 + r * Math.sin(a) * 0.7, vx: 0, vy: 0, r: R[n.kind], nb: new Set([n.id]) });
    byId.set(n.id, n);
  });
  const links = data.links.map((l) => ({ ...l, a: byId.get(l.s), b: byId.get(l.t) }));
  links.forEach((l) => { l.a.nb.add(l.b.id); l.b.nb.add(l.a.id); });
  const on = { topic: true, theme: true, src: true };
  const REST = { topic: 240, theme: 180, src: 110 }, K = { topic: 0.04, theme: 0.025, src: 0.05 };

  for (const l of links) {
    l.el = document.createElementNS(NS, 'line');
    l.el.setAttribute('class', `g-link g-link--${l.kind}`);
    gL.appendChild(l.el);
  }
  for (const n of data.nodes) {
    const g = document.createElementNS(NS, n.kind === 'ds' ? 'a' : 'g');
    g.setAttribute('class', `g-node g-node--${n.kind === 'ds' ? 'ds' : 'hub g-node--' + n.kind}${n.tone ? ' g-tone-' + n.tone : ''}`);
    if (n.kind === 'ds') { g.setAttribute('href', n.href); g.setAttribute('aria-label', `${n.label}, ${n.theme}, ${n.period}`); }
    const big = n.kind === 'ds' ? `<circle class="g-halo" r="${n.r + 12}"/>` : '';
    g.innerHTML = `${big}<circle r="${n.r}"/><text x="0" y="${n.r + 15}" text-anchor="middle"></text>`;
    g.querySelector('text').textContent = n.label;
    n.el = g; gN.appendChild(g);
  }

  let alpha = 1;
  const tick = () => {
    const ns = data.nodes;
    for (let i = 0; i < ns.length; i++) for (let j = i + 1; j < ns.length; j++) {
      const p = ns[i], q = ns[j]; let dx = q.x - p.x, dy = q.y - p.y, d2 = Math.max(dx * dx + dy * dy, 400);
      const f = (p.kind === 'ds' && q.kind === 'ds' ? 40000 : 14000) / d2 * alpha, d = Math.sqrt(d2);
      dx /= d; dy /= d; p.vx -= dx * f; p.vy -= dy * f; q.vx += dx * f; q.vy += dy * f;
    }
    for (const l of links) {
      if (!on[l.kind]) continue;
      const dx = l.b.x - l.a.x, dy = l.b.y - l.a.y, d = Math.hypot(dx, dy) || 1, f = (d - REST[l.kind]) * K[l.kind] * alpha;
      l.a.vx += dx / d * f; l.a.vy += dy / d * f; l.b.vx -= dx / d * f; l.b.vy -= dy / d * f;
    }
    for (const n of ns) {
      n.vx += (W / 2 - n.x) * 0.0008 * alpha; n.vy += (H / 2 - n.y) * 0.005 * alpha;
      if (n.fixed) { n.vx = n.vy = 0; continue; }
      n.vx *= 0.82; n.vy *= 0.82;
      const sp = Math.hypot(n.vx, n.vy); if (sp > 30) { n.vx *= 30 / sp; n.vy *= 30 / sp; }
      n.x += n.vx; n.y += n.vy;
      n.x = Math.max(90, Math.min(W - 90, n.x)); n.y = Math.max(40, Math.min(H - 40, n.y));
    }
    alpha = Math.max(alpha * 0.985, 0.002);
  };
  const draw = () => {
    for (const l of links) { l.el.setAttribute('x1', l.a.x.toFixed(1)); l.el.setAttribute('y1', l.a.y.toFixed(1)); l.el.setAttribute('x2', l.b.x.toFixed(1)); l.el.setAttribute('y2', l.b.y.toFixed(1)); l.el.style.display = on[l.kind] ? '' : 'none'; }
    for (const n of data.nodes) n.el.setAttribute('transform', `translate(${n.x.toFixed(1)},${n.y.toFixed(1)})`);
  };
  let raf = 0;
  const run = () => { tick(); draw(); raf = alpha > 0.01 || drag ? requestAnimationFrame(run) : 0; };
  const heat = (a) => { alpha = Math.max(alpha, a); if (reduce) { for (let i = 0; i < 400; i++) tick(); draw(); } else if (!raf) raf = requestAnimationFrame(run); };

  // Hover / focus: light up a node and its neighbours.
  const lit = (n) => {
    root.classList.toggle('is-focus', !!n);
    for (const m of data.nodes) m.el.classList.toggle('is-lit', !!n && n.nb.has(m.id));
    for (const l of links) l.el.classList.toggle('is-lit', !!n && (l.a === n || l.b === n));
    if (!n || n.kind !== 'ds') { tip.hidden = true; return; }
    const why = links.filter((l) => l.kind === 'topic' && (l.a === n || l.b === n)).map((l) => `↔ ${(l.a === n ? l.b : l.a).label}: ${l.why}`);
    tip.innerHTML = '';
    const b = document.createElement('b'); b.textContent = `${n.code} · ${n.period}`; tip.appendChild(b);
    for (const w of why) { const s = document.createElement('span'); s.textContent = w; s.style.display = 'block'; tip.appendChild(s); }
    const box = svg.getBoundingClientRect(), rb = root.getBoundingClientRect();
    tip.style.left = `${box.left - rb.left + n.x / W * box.width}px`;
    tip.style.top = `${box.top - rb.top + (n.y - n.r) / H * box.height}px`;
    tip.hidden = false;
  };
  data.nodes.forEach((n) => {
    n.el.addEventListener('pointerenter', () => { if (!drag) lit(n); });
    n.el.addEventListener('pointerleave', () => { if (!drag) lit(null); });
    n.el.addEventListener('focus', () => lit(n));
    n.el.addEventListener('blur', () => lit(null));
  });

  // Drag: pointer to viewBox coordinates.
  let drag = null, moved = false;
  const pt = (e) => { const m = svg.getScreenCTM().inverse(); return { x: (e.clientX * m.a + e.clientY * m.c + m.e), y: (e.clientX * m.b + e.clientY * m.d + m.f) }; };
  svg.addEventListener('pointerdown', (e) => {
    const g = e.target.closest('.g-node'); if (!g) return;
    drag = data.nodes.find((n) => n.el === g); moved = false;
    drag.fixed = true; svg.setPointerCapture(e.pointerId); svg.classList.add('is-dragging');
    heat(0.3);
  });
  svg.addEventListener('pointermove', (e) => {
    if (!drag) return; const p = pt(e);
    if (Math.hypot(p.x - drag.x, p.y - drag.y) > 3) moved = true;
    drag.x = p.x; drag.y = p.y; lit(drag); heat(0.3);
  });
  const end = () => { if (!drag) return; drag.fixed = false; drag = null; svg.classList.remove('is-dragging'); lit(null); heat(0.1); };
  svg.addEventListener('pointerup', end); svg.addEventListener('pointercancel', end);
  svg.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);

  root.querySelectorAll('[data-gk]').forEach((cb) => cb.addEventListener('change', () => { on[cb.dataset.gk] = cb.checked; heat(0.6); draw(); }));
  root.querySelector('[data-graph-reset]').addEventListener('click', () => {
    data.nodes.forEach((n, i) => { const a = i * 2.39996, r = 40 + 9 * i; n.x = W / 2 + r * Math.cos(a); n.y = H / 2 + r * Math.sin(a) * 0.7; n.vx = n.vy = 0; });
    heat(1);
  });

  // Settle off-screen first, then animate in when the graph scrolls into view.
  for (let i = 0; i < (reduce ? 400 : 60); i++) tick();
  draw();
  if (!reduce) new IntersectionObserver((es, io) => { if (es[0].isIntersecting) { heat(0.5); io.disconnect(); } }, { threshold: 0.2 }).observe(root);
})();
</script>
<script is:inline>
// LeaderLine: dashed 1px ink line with an open-circle end, from a MarginNote to
// the element it annotates. Positioned from geometry, recalculated on resize.
// Hidden below 900px (CSS), where notes sit inline instead.
const NS = 'http://www.w3.org/2000/svg';
function anchor(r, side, sx, sy) {
    switch (side) {
        case 'left': return [r.left + sx, r.top + r.height / 2 + sy];
        case 'right': return [r.right + sx, r.top + r.height / 2 + sy];
        case 'top': return [r.left + r.width / 2 + sx, r.top + sy];
        case 'bottom': return [r.left + r.width / 2 + sx, r.bottom + sy];
        default: return [r.left + r.width / 2 + sx, r.top + r.height / 2 + sy];
    }
}
function drawLeaders(root = document) {
    const notes = Array.from(root.querySelectorAll('[data-leader-to]')).filter((n) => n.dataset.leaderTo);
    let svg = document.getElementById('leader-layer');
    if (!svg) {
        svg = document.createElementNS(NS, 'svg');
        svg.id = 'leader-layer';
        svg.setAttribute('aria-hidden', 'true');
        document.body.appendChild(svg);
    }
    // measure the page without this layer: sized to its own height, it kept growing the page
    svg.setAttribute('width', '0');
    svg.setAttribute('height', '0');
    const W = document.documentElement.scrollWidth, H = document.documentElement.scrollHeight;
    svg.setAttribute('width', String(W));
    svg.setAttribute('height', String(H));
    svg.replaceChildren();
    if (innerWidth < 900)
        return;
    const sx = scrollX, sy = scrollY;
    for (const note of notes) {
        const target = document.getElementById(note.dataset.leaderTo);
        if (!target || note.offsetParent === null || target.getClientRects().length === 0)
            continue;
        if (note.closest('[data-leaders-off]'))
            continue;
        const nr = note.getBoundingClientRect(), tr = target.getBoundingClientRect();
        const tc = [tr.left + tr.width / 2, tr.top + tr.height / 2];
        const nc = [nr.left + nr.width / 2, nr.top + nr.height / 2];
        const horizontal = tc[0] > nr.right || tc[0] < nr.left;
        const path = document.createElementNS(NS, 'path');
        let x2, y2;
        if (horizontal) {
            // Route: out of the note's first line, along the gutter beside the
            // annotated block, then under the target's line of text to the target.
            const right = tc[0] > nc[0];
            const block = target.closest('p, li, figure, svg, h1, h2, h3, [data-leader-block]') ?? target;
            const br = block.getBoundingClientRect();
            const x1 = (right ? nr.right + 8 : nr.left - 8) + sx;
            const y1 = nr.top + 12 + sy;
            let gx = right ? Math.max(br.left - 14, nr.right + 16) : Math.min(br.right + 14, nr.left - 16);
            gx += sx;
            const at = note.dataset.leaderAt || 'bottom';
            [x2, y2] = at === 'bottom' ? [tc[0] + sx, tr.bottom + 3 + sy] : anchor(tr, at, sx, sy);
            path.setAttribute('d', `M${x1},${y1} H${gx} V${y2} H${x2}`);
        }
        else {
            // note directly above or below: straight drop
            const below = tc[1] > nc[1];
            const x1 = Math.min(Math.max(tc[0], nr.left + 12), nr.right - 12) + sx;
            const y1 = (below ? nr.bottom + 8 : nr.top - 8) + sy;
            [x2, y2] = [tc[0] + sx, (below ? tr.top - 3 : tr.bottom + 3) + sy];
            path.setAttribute('d', `M${x1},${y1} V${(y1 + y2) / 2} H${x2} V${y2}`);
        }
        path.setAttribute('class', 'leader');
        const dot = document.createElementNS(NS, 'circle');
        dot.setAttribute('cx', String(x2));
        dot.setAttribute('cy', String(y2));
        dot.setAttribute('r', '3');
        dot.setAttribute('class', 'leader-end');
        if (note.closest('.ground-ink')) {
            path.classList.add('leader--inv');
            dot.classList.add('leader--inv');
        }
        svg.append(path, dot);
    }
}
function initLeaders() {
    let raf = 0;
    const redraw = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(() => drawLeaders()); };
    redraw();
    addEventListener('resize', redraw);
    addEventListener('load', redraw);
    document.fonts?.ready.then(redraw);
    if ('ResizeObserver' in window)
        new ResizeObserver(redraw).observe(document.body);
    window.__redrawLeaders = redraw;
}

const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
// Entrances: 14px rise, staggered via --d set in markup.
const rise = document.querySelectorAll('.rise');
if (reduce || !('IntersectionObserver' in window)) {
    rise.forEach((el) => el.classList.add('is-in'));
}
else {
    const io = new IntersectionObserver((entries) => {
        for (const e of entries)
            if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
            }
    }, { rootMargin: '0px 0px -8% 0px' });
    rise.forEach((el) => io.observe(el));
}
initLeaders();


// Sortable tables: any <table data-sortable> whose header cells contain a
// <button data-sort="text|num">. Keyboard-usable buttons; aria-sort updated.
for (const table of document.querySelectorAll('table[data-sortable]')) {
    const tbody = table.tBodies[0];
    table.querySelectorAll('th button[data-sort]').forEach((btn) => {
        btn.addEventListener('click', () => {
            const th = btn.closest('th');
            const col = Array.from(th.parentElement.children).indexOf(th);
            const asc = th.getAttribute('aria-sort') !== 'ascending';
            table.querySelectorAll('th').forEach((h) => h.removeAttribute('aria-sort'));
            th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
            const num = btn.dataset.sort === 'num';
            const key = (r) => {
                const c = r.cells[col];
                const v = c.dataset.value ?? c.textContent ?? '';
                return num ? parseFloat(v.replace(/,/g, '')) : v.toLowerCase();
            };
            // the "no results" row has one cell: it stays out of the sort, at the end
            const empty = tbody.querySelector('[data-dsx-empty]');
            const rows = Array.from(tbody.rows).filter((r) => r !== empty).sort((a, b) => {
                const x = key(a), y = key(b);
                return (x < y ? -1 : x > y ? 1 : 0) * (asc ? 1 : -1);
            });
            tbody.append(...rows);
            if (empty) tbody.append(empty);
        });
    });
}

// Citation copy buttons: copy the plain text of the citation next to them.
document.querySelectorAll('[data-cite-copy]').forEach((b) => b.addEventListener('click', async () => {
    const text = b.parentElement.querySelector('[data-cite]').textContent.trim();
    try { await navigator.clipboard.writeText(text); b.textContent = 'Copied'; }
    catch { b.textContent = 'Select and copy'; }
    setTimeout(() => { b.textContent = 'Copy'; }, 1800);
}));

// Dataset search + live autocomplete recommendations.
// Suggestions use the same catalog-backed rows as the existing dataset table.
const dsxQ = document.querySelector('[data-dsx-q]');

if (dsxQ) {
    const rows = Array.from(document.querySelectorAll('[data-dsx-row]'));
    const empty = document.querySelector('[data-dsx-empty]');
    const count = document.querySelector('[data-dsx-count]');
    const themeBtns = Array.from(document.querySelectorAll('[data-dsx-theme]'));
    const suggestions = document.querySelector('#dsx-suggestions');
    let theme = '';
    let matches = [];
    let activeIndex = -1;

    const titleOf = (row) => row.querySelector('td a')?.textContent.trim() || '';

    const closeSuggestions = () => {
        suggestions.hidden = true;
        suggestions.replaceChildren();
        dsxQ.setAttribute('aria-expanded', 'false');
        dsxQ.removeAttribute('aria-activedescendant');
        activeIndex = -1;
    };

    const apply = () => {
        const words = dsxQ.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        let shown = 0;

        for (const row of rows) {
            const searchable = row.dataset.search || '';
            const matchesText = words.every((word) => searchable.includes(word));
            const matchesTheme = !theme || row.dataset.theme === theme;
            const visible = matchesText && matchesTheme;
            row.hidden = !visible;
            if (visible) shown++;
        }

        if (empty) empty.hidden = shown > 0;
        if (count) count.textContent = `${shown} of ${rows.length} datasets`;
    };

    const renderSuggestions = () => {
        const query = dsxQ.value.trim().toLowerCase();
        closeSuggestions();
        matches = [];
        if (!query) return;

        matches = rows
            .filter((row) => !theme || row.dataset.theme === theme)
            .map((row) => ({
                row,
                title: titleOf(row),
                searchable: row.dataset.search || '',
                theme: row.dataset.theme || ''
            }))
            // Match the beginning of every dataset title for any letter A-Z.
            // Return every matching dataset; do not cap the recommendation list.
            .filter((item) => item.title.toLowerCase().startsWith(query))
            .sort((a, b) => a.title.localeCompare(b.title));

        if (!matches.length) {
            const message = document.createElement('div');
            message.className = 'dsx-suggestion-empty';
            message.textContent = 'No matching datasets found';
            suggestions.append(message);
        } else {
            matches.forEach((item, index) => {
                const option = document.createElement('button');
                option.type = 'button';
                option.className = 'dsx-suggestion';
                option.id = `dsx-option-${index}`;
                option.setAttribute('role', 'option');
                option.setAttribute('aria-selected', 'false');
                option.dataset.suggestionIndex = String(index);

                const title = document.createElement('span');
                title.className = 'dsx-suggestion-title';
                title.textContent = item.title;

                const meta = document.createElement('span');
                meta.className = 'dsx-suggestion-meta';
                meta.textContent = item.theme;

                option.append(title, meta);
                suggestions.append(option);
            });
        }

        suggestions.hidden = false;
        dsxQ.setAttribute('aria-expanded', 'true');
    };

    const selectSuggestion = (index) => {
        const item = matches[index];
        const link = item?.row.querySelector('td a');
        if (link?.href) window.location.href = link.href;
    };

    dsxQ.addEventListener('input', () => {
        apply();
        renderSuggestions();
    });

    dsxQ.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            closeSuggestions();
            return;
        }
        if (suggestions.hidden || !matches.length) return;

        if (event.key === 'ArrowDown') {
            event.preventDefault();
            activeIndex = Math.min(activeIndex + 1, matches.length - 1);
        } else if (event.key === 'ArrowUp') {
            event.preventDefault();
            activeIndex = activeIndex <= 0 ? 0 : activeIndex - 1;
        } else if (event.key === 'Enter' && activeIndex >= 0) {
            event.preventDefault();
            selectSuggestion(activeIndex);
            return;
        } else {
            return;
        }

        suggestions.querySelectorAll('[role="option"]').forEach((option, index) => {
            option.setAttribute('aria-selected', String(index === activeIndex));
        });
        dsxQ.setAttribute('aria-activedescendant', `dsx-option-${activeIndex}`);
        suggestions.querySelector('[aria-selected="true"]')?.scrollIntoView({ block: 'nearest' });
    });

    suggestions.addEventListener('click', (event) => {
        const option = event.target.closest('[data-suggestion-index]');
        if (option) selectSuggestion(Number(option.dataset.suggestionIndex));
    });

    document.addEventListener('click', (event) => {
        if (!event.target.closest('.dsx-autocomplete')) closeSuggestions();
    });

    themeBtns.forEach((button) => button.addEventListener('click', () => {
        theme = button.dataset.dsxTheme || '';
        themeBtns.forEach((item) => {
            item.setAttribute('aria-pressed', String(item === button));
        });
        apply();
        renderSuggestions();
    }));

    const q = new URLSearchParams(location.search).get('q');
    if (q) {
        dsxQ.value = q;
        apply();
        renderSuggestions();
    }
}

