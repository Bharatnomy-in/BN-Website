            .replace(/class="sk-line"/g, 'fill="none" stroke="#16181C" stroke-width="0.9"').replace(/class="sk-hatch"/g, 'fill="none" stroke="#16181C" stroke-width="0.55" opacity="0.4"');
        const im = new Image();
        im.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(xml);
        await im.decode();
        img = im;
    }
    if (img) {
        const iw = img.width, ih = img.height;
        const box = { x: 60, y: 170, w: 1100, h: 780 };
        const k = Math.min(box.w / iw, box.h / ih);
        g.drawImage(img, box.x + (box.w - iw * k) / 2, box.y + (box.h - ih * k) / 2, iw * k, ih * k);
    }
    g.fillStyle = '#16181C';
    g.font = '800 64px "Big Shoulders Display", Archivo, sans-serif';
    g.fillText(title, 60, 100);
    g.font = '500 20px "Geist Mono", monospace';
    g.fillStyle = '#4C535C';
    g.fillText(subtitle.toUpperCase(), 60, 140);
    // legend
    let y = 220;
    g.fillStyle = '#16181C';
    g.font = '500 16px "Geist Mono", monospace';
    g.fillText(legendTitle.toUpperCase(), 1200, y);
    y += 20;
    for (const e of legend.legend) {
        g.fillStyle = e.color;
        g.fillRect(1200, y, 36, 20);
        g.strokeStyle = '#16181C';
        g.strokeRect(1200.5, y + 0.5, 36, 20);
        g.fillStyle = '#16181C';
        g.font = '400 16px "Geist Mono", monospace';
        g.fillText(e.label, 1250, y + 15);
        y += 30;
    }
    g.fillStyle = '#4C535C';
    g.font = '400 14px "Geist Mono", monospace';
    const words = source.toUpperCase().split(' ');
    let line = '', ly = 1010;
    for (const w of words) {
        if (g.measureText(line + w).width > 1480) {
            g.fillText(line, 60, ly);
            ly += 22;
            line = '';
        }
        line += w + ' ';
    }
    g.fillText(line, 60, ly);
    g.fillStyle = '#16181C';
    g.font = '800 22px "Big Shoulders Display", sans-serif';
    g.fillText('BHARATNOMY', W - 190, H - 30);
    const blob = await new Promise((r) => out.toBlob((b) => r(b), 'image/png'));
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `bharatnomy-atlas-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}.png`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
}


const RELATED = {
    temperature: ['tmax_highest_c', 'days_tmax_40c_or_more', 'tmax_mean_anomaly_c'],
    rainfall: ['rainfall_jun_sep_mm', 'rainfall_jun_sep_departure_pct', 'rx1day_mm'],
};
const DASHES = ['', '6 3', '2 3', '9 3 2 3'];
function periodLabel(f, s) {
    return s.view === 'year' ? String(s.year) : s.view === 'decade' ? decadeLabel(s.year, f) : `${s.b[0]}–${s.b[1]} vs ${s.a[0]}–${s.a[1]}`;
}
async function renderPanel(el, ctx) {
    const { s, m, f, unit, shown, byLgd } = ctx;
    if (!s.district) {
        el.innerHTML = `<div class="panel-empty"><p class="t-lead">Select a district on the map, or search for one.</p><p class="soft">Each district panel shows the readings for the period on the map, its rank among ${ctx.districts.length}, and its full record since ${f.years[0]}.</p></div>`;
        return;
    }
    const d = byLgd[s.district];
    const v = shown[s.district];
    // rank among districts (numeric metrics)
    let rankLine = '';
    if (typeof v === 'number') {
        const sorted = Object.values(shown).filter((x) => typeof x === 'number').sort((a, b) => b - a);
        const r = sorted.indexOf(v) + 1;
        const word = s.view === 'change' ? 'largest increase' : m.higherIs ?? 'highest';
        rankLine = `${ordinal(r)} ${word} of ${sorted.length}`;
    }
    // readings: the active metric plus related ones (same period)
    const rows = [{ label: m.short, value: fmtVal(v, m, s, unit), note: rankLine.toUpperCase() }];
    if (s.view !== 'change') {
        for (const id of RELATED[m.dataset].filter((x) => x !== m.id).slice(0, 3)) {
            const rm = metricById(id);
            try {
                const rf = await loadMetric(m.dataset, id);
                rows.push({ label: rm.short, value: fmtVal(viewValues(rf, s)[s.district] ?? null, rm, s, rm.unit) });
            }
            catch { /* skip a related metric that failed to load */ }
        }
    }
    const period = periodLabel(f, s);
    // trend: selected + compared districts, whole record
    let chart = '';
    if (m.breaks === 'categorical') {
        const stops = STOPS.category, cats = m.categories;
        chart = `<div class="cat-strip" role="img" aria-label="${esc(m.label)} for ${esc(d.name)}, every year">${f.years.map((y, i) => {
            const c = f.values[s.district][i];
            return `<span title="${y}: ${c ?? 'no data'}" style="background:${c ? stops[cats.indexOf(c)] : 'transparent'}"${y === s.year ? ' class="is-year"' : ''}></span>`;
        }).join('')}</div><p class="label soft cat-axis"><span>${f.years[0]}</span><span>${f.years[f.years.length - 1]}</span></p>`;
    }
    else {
        const ids = [s.district, ...s.compare];
        const dark = m.scale === 'wet' || m.scale === 'wetdry' ? STOPS.wet : m.scale === 'dry' ? STOPS.dry : STOPS.warm;
        const series = ids.map((id, i) => ({ label: byLgd[id].name, values: f.values[id], style: (i === 0 ? 'ink' : 'ink'), dash: DASHES[i] || undefined, color: i === 0 ? undefined : dark[4 - (i - 1)] }));
        chart = renderTrend({
            years: f.years, series, width: 440, height: 200, unit, decimals: m.decimals,
            baseline: baselineOf(m.dataset), highlight: s.view === 'year' ? s.year : undefined,
            rolling: ids.length === 1 ? 10 : undefined, zeroLine: m.breaks !== 'quantile',
            title: `${m.label}, ${ids.map((i) => byLgd[i].name).join(', ')}`,
        });
    }
    const key = [s.district, ...s.compare].map((id, i) => `<li><svg width="28" height="8" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" stroke="${i === 0 ? '#16181C' : 'currentColor'}" stroke-width="1.5" stroke-dasharray="${DASHES[i]}"/></svg>${esc(byLgd[id].name)}${i > 0 ? ` <button type="button" class="chip-x" data-remove="${id}" aria-label="Remove ${esc(byLgd[id].name)} from compare">×</button>` : ''}</li>`).join('');
    const options = ctx.districts.filter((x) => x.lgd !== s.district && !s.compare.includes(x.lgd)).map((x) => `<option value="${x.lgd}">${esc(x.name)}</option>`).join('');
    el.innerHTML = `
    <div class="dp-head">
      <h2 class="display dp-name">${esc(d.name)}</h2>
      <button type="button" class="label dp-clear" data-clear>Clear</button>
    </div>
    <p class="label soft">LGD ${d.lgd} · CENSUS 2011 BOUNDARY${d.name === 'Thane' ? ' · INCLUDES PALGHAR' : ''}</p>
    <section class="panel dp-readings" aria-label="Readings"><span class="panel-plus" aria-hidden="true">+</span>
      <h3 class="label panel-title">${esc(d.name.toUpperCase())} · ${esc(period.toUpperCase())}</h3>
      <dl class="panel-rows">${rows.map((r) => `<div class="panel-row"><dt class="label soft">${esc(r.label)}</dt><dd class="panel-val num">${esc(r.value)}${r.note ? `<span class="label soft panel-note">${esc(r.note)}</span>` : ''}</dd></div>`).join('')}</dl>
    </section>
    <figure class="dp-trend">
      <p class="label">${esc(m.short)} · ${f.years[0]}–${f.years[f.years.length - 1]}</p>
      ${chart}
      <ul class="dp-key mono">${key}</ul>
      <figcaption class="source label">SOURCE: ${esc(ctx.source.toUpperCase())}${m.breaks !== 'categorical' ? ` · SHADED BAND = ${baselineOf(m.dataset).join('–')} NORMAL${s.compare.length ? '' : ' · BLUE = 10-YEAR ROLLING MEAN'}` : ''}</figcaption>
    </figure>
    <div class="dp-compare">
      <label class="label" for="dp-add">Compare with (up to 3)</label>
      <select id="dp-add" ${s.compare.length >= 3 ? 'disabled' : ''}><option value="">Add a district…</option>${options}</select>
    </div>
    <p><button type="button" class="btn" data-dl><span>Download ${esc(d.name)} rows (CSV)</span><span class="btn-arrow" aria-hidden="true">↓</span></button></p>`;
    el.querySelector('[data-clear]').addEventListener('click', ctx.onClear);
    el.querySelector('#dp-add').addEventListener('change', (e) => {
        const v = e.target.value;
        if (v)
            ctx.onCompare(v, null);
    });
    el.querySelectorAll('[data-remove]').forEach((b) => b.addEventListener('click', () => ctx.onCompare(null, b.dataset.remove)));
    el.querySelector('[data-dl]').addEventListener('click', () => downloadDistrict(m.dataset, s.district, d.name));
}
const csvCache = new Map();
async function downloadDistrict(ds, lgd, name) {
    const meta = datasets.find((x) => x.slug === ds);
    const url = u(`/data/${ds}/${meta.folder}.csv`);
    if (!csvCache.has(url))
        csvCache.set(url, fetch(url).then((r) => r.text()));
    const text = await csvCache.get(url);
    const lines = text.split(/\r?\n/);
    const head = lines[0].split(',');
    const col = head.indexOf('lgd_district_code');
    const rows = lines.slice(1).filter((l) => l && l.split(',')[col] === lgd);
    const blob = new Blob([[lines[0], ...rows].join('\n') + '\n'], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `${meta.folder}_${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}.csv`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
}


async function boot() {
    const root = document.querySelector('[data-atlas]');
    const $ = (sel) => root.querySelector(sel);
    const $$ = (sel) => Array.from(root.querySelectorAll(sel));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = matchMedia('(max-width: 899px)');
    const [districts, geo, stateGeo, stats] = await Promise.all([
        fetch(u('/data/districts.json')).then((r) => r.json()),
        fetch(u('/data/districts.geojson')).then((r) => r.json()),
        fetch(u('/data/state.geojson')).then((r) => r.json()),
        fetch(u('/data/stats.json')).then((r) => r.json()),
    ]);
    const byLgd = Object.fromEntries(districts.map((d) => [d.lgd, d]));
    const names = Object.fromEntries(districts.map((d) => [d.lgd, d.name]));
    const centroids = Object.fromEntries(districts.map((d) => [d.lgd, [d.cx, d.cy]]));
    const lastYear = (ds) => stats.datasets.find((d) => d.slug === ds)?.last_year ?? 2024;
    const firstYear = (ds) => stats.datasets.find((d) => d.slug === ds)?.first_year ?? 1951;
    let s = fromURL(lastYear, new Set(Object.keys(byLgd)));
    let f;
    let shown = {};
    let colors = {};
    let scale;
    /* ---------------------------------------------------------- controls ---- */
    function syncControls() {
        $$('[data-ds]').forEach((b) => { const on = b.dataset.ds === s.dataset; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; });
        $$('[data-metric-item]').forEach((li) => { li.hidden = li.dataset.dataset !== s.dataset; });
        $$('input[name="metric"]').forEach((i) => { i.checked = i.value === s.metric; });
        const cat = metricById(s.metric).breaks === 'categorical';
        $$('input[name="view"]').forEach((i) => { i.checked = i.value === s.view; i.disabled = cat && i.value !== 'year'; });
        $('[data-change-periods]').hidden = s.view !== 'change';
        const [fa, la] = [firstYear(s.dataset), lastYear(s.dataset)];
        $$('[data-period]').forEach((i) => {
            const [p, k] = i.dataset.period.split('.');
            i.min = String(fa);
            i.max = String(la);
            i.value = String(s[p][+k]);
        });
        const div = metricById(s.metric).breaks !== 'quantile';
        $$('input[name="classes"]').forEach((i) => { i.checked = i.value === s.classes; i.disabled = div || s.view === 'change'; });
        $('[data-classes-note]').hidden = !(div || s.view === 'change');
        $('[data-toggle="sketch"]').setAttribute('aria-pressed', String(s.sketch));
        $('[data-toggle="table"]').setAttribute('aria-pressed', String(s.table));
        const m = metricById(s.metric);
        $('[data-help]').innerHTML = `<span class="label mnote-label">${m.short}</span>${m.help}${m.caveat ? ` <em>${m.caveat}</em>` : ''}`;
    }
    /* ------------------------------------------------------------ update ---- */
    let atlas;
    let pending = 0;
    async function update(opts = {}) {
        const ticket = ++pending;
        const m = metricById(s.metric);
        f = await loadMetric(s.dataset, s.metric);
        if (ticket !== pending)
            return;
        shown = viewValues(f, s);
        scale = scaleFor(f, m, s, shown);
        colors = Object.fromEntries(Object.entries(shown).map(([k, v]) => [k, v == null ? null : scale.color(v)]));
        atlas.setColors(colors, reduce ? 0 : opts.fade ?? (opts.animate ? 350 : 0));
        atlas.setSelection(s.district, s.compare, names, centroids);
        const period = periodLabel(f, s);
        $('[data-map-title]').textContent = s.view === 'change' ? `Change in ${m.label.replace(/ \(.*\)$/, '').toLowerCase()}` : m.label;
        $('[data-map-period]').textContent = s.view === 'decade' ? `${decadeLabel(s.year, f)} average` : period;
        const legendTitle = `${s.view === 'change' ? 'Change' : m.short}${scale.unit && scale.unit !== 'SPI' ? ' · ' + scale.unit.toUpperCase() : ''}`;
        renderLegend($('[data-legend]'), legendTitle, scale, Object.values(colors).some((c) => c == null));
        const ds = datasets.find((d) => d.slug === s.dataset);
        const source = `${ds.source}, ${f.years[0]}–${f.years[f.years.length - 1]} · district indices computed by Bharatnomy`;
        $('[data-source]').innerHTML = `SOURCE: ${source.toUpperCase()} · ${m.label.toUpperCase()} · ${period.toUpperCase()} · <a href="${u(`/datasets/${s.dataset}`)}">DATASET</a>`;
        ruler.set(s.year, f.state_mean, f.years, s.view === 'change');
        // views
        const showSketch = s.sketch && !s.table;
        $('[data-map]').hidden = showSketch || s.table;
        $('[data-sketch]').hidden = !showSketch;
        $('[data-table]').hidden = !s.table;
        if (showSketch)
            renderSketch($('[data-sketch]'), geo, stateGeo, shown, colors, s.district, s.compare, select);
        const rows = districts.map((d) => {
            const v = shown[d.lgd];
            const b = s.view !== 'change' && typeof v === 'number' ? baselineMean(f, d.lgd, s.dataset) : null;
            return { lgd: d.lgd, name: d.name, value: v, change: b == null || typeof v !== 'number' ? null : v - b };
        });
        const bl = baselineOf(s.dataset).join('–');
        if (s.table)
            renderTable($('[data-table]'), rows, m, s, scale.unit, colors, bl, select);
        if (root.dataset.tab === 'table')
            renderTable($('[data-table-m]'), rows, m, s, scale.unit, colors, bl, select);
        if (!s.table && !showSketch)
            requestAnimationFrame(() => atlas.resize());
        if (opts.panel !== false)
            await renderPanel($('[data-panel]'), {
                s, m, f, unit: scale.unit, shown, districts, byLgd, source,
                onCompare: (add, remove) => {
                    if (add && !s.compare.includes(add) && s.compare.length < 3)
                        s.compare.push(add);
                    if (remove)
                        s.compare = s.compare.filter((c) => c !== remove);
                    commit({ panel: true });
                },
                onClear: () => { s.district = null; s.compare = []; commit({}); },
            });
        // screen-reader summary
        const ranked = Object.entries(shown).filter(([, v]) => typeof v === 'number').sort((a, b) => b[1] - a[1]);
        const sr = ranked.length
            ? `${m.label}, ${period}. Highest: ${names[ranked[0][0]]}, ${fmtVal(ranked[0][1], m, s, scale.unit)}. Lowest: ${names[ranked[ranked.length - 1][0]]}, ${fmtVal(ranked[ranked.length - 1][1], m, s, scale.unit)}.`
            : `${m.label}, ${period}.`;
        clearTimeout(window.__srT);
        window.__srT = setTimeout(() => { $('[data-sr]').textContent = sr; }, 400);
        toURL(s);
    }
    function commit(opts = {}) { syncControls(); update(opts); }
    function select(lgd) {
        s.district = lgd;
        if (lgd)
            s.compare = s.compare.filter((c) => c !== lgd);
        if (lgd && mobile.matches)
            setTab('district');
        commit({});
    }
    /* ------------------------------------------------------------ events ---- */
    $$('[data-ds]').forEach((b) => {
        b.addEventListener('click', () => {
            if (b.dataset.ds === s.dataset)
                return;
            const keep = { district: s.district, compare: s.compare, view: s.view, year: s.year, sketch: s.sketch, table: s.table, classes: s.classes };
            s = { ...defaults(b.dataset.ds, lastYear(b.dataset.ds)), ...keep };
            s.year = Math.min(s.year, lastYear(s.dataset));
            commit({ animate: true });
        });
        b.addEventListener('keydown', (e) => {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft')
                return;
            const tabs = $$('[data-ds]');
            const i = tabs.indexOf(b);
            const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
            n.focus();
            n.click();
        });
    });
    root.addEventListener('change', (e) => {
        const t = e.target;
        if (t.name === 'metric') {
            s.metric = t.value;
            if (metricById(s.metric).breaks === 'categorical')
                s.view = 'year';
            commit({ animate: true });
        }
        if (t.name === 'view') {
            s.view = t.value;
            commit({ animate: true });
        }
        if (t.name === 'classes') {
            s.classes = t.value;
            commit({ animate: true });
        }
        if (t.dataset.period) {
            const [p, k] = t.dataset.period.split('.');
            const v = Math.max(firstYear(s.dataset), Math.min(lastYear(s.dataset), Math.round(+t.value || 0)));
            const arr = [...s[p]];
            arr[+k] = v;
            if (arr[0] > arr[1])
                arr.reverse();
            s[p] = arr;
            commit({ animate: true });
        }
    });
    $$('[data-toggle]').forEach((b) => b.addEventListener('click', () => {
        const k = b.dataset.toggle;
        s[k] = !s[k];
        if (k === 'sketch' && s.sketch)
            s.table = false;
        if (k === 'table' && s.table)
            s.sketch = false;
        commit({});
    }));
    $('[data-png]').addEventListener('click', () => {
        const m = metricById(s.metric);
        savePNG(s.sketch ? null : atlas.map.getCanvas(), s.sketch ? $('[data-sketch] svg') : null, $('[data-map-title]').textContent ?? m.label, `Maharashtra · ${$('[data-map-period]').textContent}`, scale, `${s.view === 'change' ? 'Change' : m.short}${scale.unit ? ' · ' + scale.unit : ''}`, $('[data-source]').textContent ?? '');
    });
    // search (native datalist: keyboard friendly)
    const search = $('#district-search');
    const pick = () => {
        const q = search.value.trim().toLowerCase();
        const d = districts.find((x) => x.name.toLowerCase() === q) ?? districts.find((x) => x.name.toLowerCase().startsWith(q));
        if (d && q) {
            select(d.lgd);
            search.value = '';
        }
    };
    search.addEventListener('change', pick);
    search.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault();
            pick();
        }
    });
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !e.target.closest('input, select, textarea') && s.district)
            select(null);
    });
    // play: about four years a second; never starts on its own
    const play = $('[data-play]');
    let timer = 0;
    const PLAY_STEP = 900, PLAY_FADE = 800;
    const stopPlay = () => { clearInterval(timer); timer = 0; $('[data-ruler]').classList.remove('is-playing'); play.setAttribute('aria-pressed', 'false'); play.querySelector('span').textContent = 'Play'; };
    play.addEventListener('click', () => {
        if (timer)
            return stopPlay();
        if (s.view === 'change')
            return;
        if (s.year >= lastYear(s.dataset))
            s.year = firstYear(s.dataset);
        play.setAttribute('aria-pressed', 'true');
        play.querySelector('span').textContent = 'Pause';
        $('[data-ruler]').classList.add('is-playing');
        // one year about every 0.9 s; colours crossfade over most of each step so it reads as a glide
        timer = window.setInterval(() => {
            if (s.year >= lastYear(s.dataset))
                return stopPlay();
            s.year++;
            update({ panel: !!s.district, fade: reduce ? 0 : PLAY_FADE });
        }, PLAY_STEP);
    });
    // mobile bottom sheet tabs
    function setTab(t) {
        root.dataset.tab = t;
        $$('[data-tab-btn]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tabBtn === t)));
        if (t === 'table')
            update({ panel: false });
    }
    $$('[data-tab-btn]').forEach((b) => b.addEventListener('click', () => setTab(b.dataset.tabBtn)));
    /* --------------------------------------------------------------- boot ---- */
    const tip = $('[data-tip]');
    const ruler = createRuler($('[data-ruler]'), (year, scrubbing) => {
        stopPlay();
        s.year = year;
        update({ panel: !scrubbing });
    });
    atlas = await createMap($('[data-map]'), geo, stateGeo, {
        onHover: (lgd, x, y) => {
            if (!lgd) {
                tip.hidden = true;
                return;
            }
            const m = metricById(s.metric);
            tip.textContent = `${names[lgd].toUpperCase()} · ${fmtVal(shown[lgd] ?? null, m, s, scale?.unit ?? m.unit).toUpperCase()}`;
            tip.hidden = false;
            tip.style.transform = `translate(${Math.round(x + 14)}px, ${Math.round(y - 30)}px)`;
        },
        onClick: (lgd) => select(lgd),
    });
    root.classList.add('is-ready');
    syncControls();
    await update({});
}
boot().catch((err) => {
    console.error(err);
    const el = document.querySelector('[data-atlas-error]');
    if (el) {
        el.removeAttribute('hidden');
    }
});


// LeaderLine: dashed 1px ink line with an open-circle end, from a MarginNote to
// the element it annotates. Positioned from geometry, recalculated on resize.
// Hidden below 900px (CSS), where notes sit inline instead.
const NS = 'http://www.w3.org/2000/svg';
function anchor(r, side, sx, sy) {
    switch (side) {
        case 'left': return [r.left + sx, r.top + r.height / 2 + sy];
        case 'right': return [r.right + sx, r.top + r.height / 2 + sy];
        case 'top': return [r.left + r.width / 2 + sx, r.top + sy];
        case 'bottom': return [r.left + r.width / 2 + sx, r.bottom + sy];
        default: return [r.left + r.width / 2 + sx, r.top + r.height / 2 + sy];
    }
