const lensTab = (o: any) => { const roman = ['I','II','III','IV','V'][o.n - 1]; const first = o.name.split(' ')[0].replace(/&$/, ''); return `<article class="lens lens--${o.lens}${o.class ? ' ' + o.class : ''}" style="--tab-offset:${(o.n - 1) * 19}%"><div class="lens-tab"><span class="label">${roman}</span><span class="lens-tab-name">${escapeHtml(first)}</span></div><div class="lens-page">${sticker(o.status, { tone: o.n === 1 ? o.lens : 'paper', seed: `lens-${o.n}`, class: 'lens-status' })}<h3 class="display t-l lens-name">${escapeHtml(o.name)}</h3><p class="lens-line">${escapeHtml(o.line)}</p><ul class="lens-focus label">${o.focus.map((f: string) => `<li>${escapeHtml(f)}</li>`).join('')}</ul></div></article>`; };
const folio = (o: any) => `<p class="folio label${o.sticky ? ' folio--sticky' : ''}${o.class ? ' ' + o.class : ''}"><span>${escapeHtml(o.code)}</span>${o.chapter ? `<span class="folio-sep" aria-hidden="true">·</span><span>CH. ${escapeHtml(o.chapter)}</span>` : ''}<span class="folio-sep" aria-hidden="true">·</span><span>${escapeHtml(o.title)}</span></p>`;
const legend = (o: any) => { const gaps = [12,8,5.5,3.6,2.5]; return `<figure class="legend${o.class ? ' ' + o.class : ''}" style="--tilt:${tilt(o.seed ?? o.title, 0)}deg"><figcaption class="label legend-title">${escapeHtml(o.title)}</figcaption>${o.hachure ? `<div class="legend-hatch"><svg viewBox="0 0 150 22" width="150" height="22" aria-hidden="true">${gaps.map((g,i)=>`<svg x="${i*30}" y="0" width="28" height="22" viewBox="0 0 28 22">${Array.from({length:Math.ceil(50/g)+1},(_,k)=>`<line x1="${k*g-20}" y1="22" x2="${k*g}" y2="0" stroke="currentColor" stroke-width="0.7"/>`).join('')}<rect x="0.5" y="0.5" width="27" height="21" fill="none" stroke="currentColor" stroke-width="0.75"/></svg>`).join('')}</svg><p class="label"><span>SPARSE = FEW HOT DAYS</span><span>DENSE = MANY</span></p>${o.range ? `<p class="mono legend-range">${escapeHtml(o.range)}</p>` : ''}</div>` : `<ul class="legend-list">${(o.entries ?? []).map((e:any)=>`<li><span class="legend-swatch" style="background:${escapeHtml(e.color)}"></span><span class="mono">${escapeHtml(e.label)}</span></li>`).join('')}${o.nodata ? '<li><span class="legend-swatch legend-swatch--nodata"></span><span class="mono">no data</span></li>' : ''}</ul>`}</figure>`; };
const trendFigure = (o: any) => `<figure class="trendfig${o.class ? ' ' + o.class : ''}">${o.caption ? `<p class="label trendfig-cap">${escapeHtml(o.caption)}</p>` : ''}<div class="trendfig-plot">${renderTrend(o)}</div><figcaption class="source label">SOURCE: ${escapeHtml(o.source)}${o.href ? ` · <a href="${escapeHtml(o.href)}">OPEN IN ATLAS</a>` : ''}</figcaption></figure>`;
const specimenTag = (o: any) => { const d=o.dataset, key=o.seed ?? d?.code ?? o.planned ?? 'tag'; const dg=tilt(key,1), drop=Math.round(rng(key+'drop')()*20), H=o.headingTag??'h3'; const basePath=d?u(`/data/${d.slug}/${d.folder}`):''; return `<article class="tag${d?'':' tag--planned'}${o.class?' '+o.class:''}" style="--tilt:${dg}deg; --drop:${drop}px"><span class="tag-string" aria-hidden="true"></span><span class="tag-hole" aria-hidden="true"></span>${d?`<p class="label tag-code">${escapeHtml(d.code)}</p><${H} class="display tag-title"><a href="${u(`/datasets/${d.slug}`)}">${escapeHtml(d.title)}</a></${H}><p class="label tag-cover">${escapeHtml(o.state??'Maharashtra').toUpperCase()} · ${d.districts} DISTRICTS · ${d.first_year}–${d.last_year}</p><dl class="tag-facts label"><div><dt>Columns</dt><dd class="num">${d.columns}</dd></div><div><dt>Rows</dt><dd class="num">${d.rows.toLocaleString('en-IN')}</dd></div><div><dt>Formats</dt><dd>CSV · JSON</dd></div><div><dt>Size</dt><dd class="num">${d.csv_kb} KB CSV</dd></div></dl><p class="tag-dl"><a href="${basePath}.csv" download>CSV</a><a href="${basePath}.json" download>JSON</a><a href="${u(`/datasets/${d.slug}`)}">Dataset page</a></p>`:`<p class="label tag-code">COMING</p><${H} class="display tag-title">${escapeHtml(o.planned)}</${H}>${o.note?`<p class="tag-note">${escapeHtml(o.note)}</p>`:''}`}</article>`; };
const sketchMap = (o: any) => { const fc=districtsGeo(); const fitTo=o.extend?{type:'FeatureCollection',features:[...fc.features,{type:'Feature',properties:{},geometry:{type:'MultiPoint',coordinates:[[o.extend[0],o.extend[1]],[o.extend[2],o.extend[3]]]}}]}:stateGeo(); const frame=frameFor(fitTo,o.width??640,o.height??470,o.pad??14); const ds=sketchDistricts(fc,{frame,values:o.values,range:o.range,seedSalt:o.seedSalt??0}); const pts=(o.waypoints??[]).map((w:any,i:number)=>{let x:number,y:number;if(w.lgd){const d=ds.find((q:any)=>q.lgd===w.lgd)!;x=d.x;y=d.y;}else [x,y]=frame.project([w.lon,w.lat]);return {...w,x,y,n:String(i+1).padStart(2,'0'),ring:roughCircle(x,y,22,900+i)};}); const route=pts.length>1?'M'+pts.map(p=>`${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' L'):''; return `<svg class="sketch${o.colors?' sketch--color':''}${o.class?' '+o.class:''}" viewBox="0 0 ${o.width??640} ${o.height??470}" role="img" aria-label="${escapeHtml(o.title)}">${o.desc?`<desc>${escapeHtml(o.desc)}</desc>`:''}<g class="sketch-districts">${ds.map((d:any)=>`<g class="sk-d${d.lgd===o.selected?' is-selected':''}" data-lgd="${d.lgd}" data-name="${escapeHtml(d.name)}"><path class="sk-hit" d="${d.plain}"${o.colors?.[d.lgd]?` style="fill:${o.colors[d.lgd]}"`:''}/>${d.hatch.length?`<path class="sk-hatch" d="${d.hatch.join(' ')}"/>`:''}<path class="sk-line" d="${d.outline.join(' ')}"/><title>${escapeHtml(d.name)}${o.values?`: ${o.values[d.lgd]==null?'no data':fmt(o.values[d.lgd],0)}${o.unit?' '+o.unit:''}`:''}</title></g>`).join('')}</g>${route?`<path class="wp-route" d="${route}"/>`:''}${pts.map(p=>`<g class="wp" transform-origin="${p.x} ${p.y}"><circle cx="${p.x}" cy="${p.y}" r="11" class="wp-fill"/><path d="${p.ring}" class="wp-ring"/><text x="${p.x}" y="${p.y+3.5}" text-anchor="middle" class="wp-n">${p.n}</text><text x="${p.x+16}" y="${p.y+4}" class="wp-label">${escapeHtml(p.label)}</text></g>`).join('')}</svg>`; };
const indiaSketch = (o:any={}) => { const width=o.width??620,height=o.height??700,cls=o.class??'',thaneId=o.thaneId??'sk-thane',mhId=o.mhId??'sk-mh';const india=indiaGeo(),frame=frameFor(india,width,height,8),states=sketchOutlines(india,frame,{roughness:.55}),mh=districtsGeo(),uniform=Object.fromEntries(mh.features.map((f:any)=>[String(f.properties.lgd),1])),ds=sketchDistricts(mh,{frame,values:uniform,range:[0,1],gap:[4.2,4.2],roughness:.5,hatchWeight:.5}),thane=ds.find((d:any)=>d.name==='Thane'),mhState=states.find((s:any)=>s.props.mapped),cx=ds.reduce((a:number,d:any)=>a+d.x,0)/ds.length,cy=ds.reduce((a:number,d:any)=>a+d.y,0)/ds.length,ring=roughCircle(cx,cy,22,4242);return `<svg class="india ${cls}" viewBox="0 0 ${width} ${height}" role="img" aria-label="Map of India by state. Maharashtra is inked in with its 35 districts; other states are outlines, not yet mapped."><g class="india-states">${states.filter((s:any)=>!s.props.mapped).map((s:any)=>`<path d="${s.d}"><title>${escapeHtml(s.props.name)}: not yet mapped</title></path>`).join('')}</g><g class="india-mh" id="${mhId}"><g class="india-mh-fill">${ds.map((d:any)=>`<path d="${d.plain}"/>`).join('')}</g><g class="india-mh-hatch">${ds.map((d:any)=>`<path d="${d.hatch.join(' ')}"/>`).join('')}</g><g class="india-mh-lines">${ds.map((d:any)=>`<path class="draw" pathLength="1" d="${d.outline.join(' ')}"${d.name==='Thane'?` id="${thaneId}"`:''}><title>${escapeHtml(d.name)}</title></path>`).join('')}</g>${mhState?`<path class="india-mh-edge" d="${mhState.d}"/>`:''}</g><g class="india-wp" id="sk-mh-pt"><circle cx="${cx}" cy="${cy}" r="11" class="wp-fill"/><path d="${ring}" class="wp-ring"/><text x="${cx}" y="${cy+3.5}" text-anchor="middle" class="wp-n">01</text></g>${thane?`<circle cx="${thane.x}" cy="${thane.y}" r="1" fill="none" id="${thaneId}-pt"/>`:''}</svg>`; };
const census = (slotHtml: string, o:any={}) => {
  const width=o.width??640,height=o.height??470,s=stats(),fc=districtsGeo(),frame=frameFor(stateGeo(),width,height,10),df=decadeFrames();
  const idx=df.decades.map((d:any,i:number)=>({...d,i})).filter((d:any,k:number,all:any[])=>d.complete||k===all.length-1).filter((d:any)=>d.start>=1960);
  const frames=idx.map((d:any)=>({label:d.complete?d.label:`${d.first}–${d.last} · PARTIAL`,first:d.first,last:d.last,i:d.i,values:Object.fromEntries(Object.entries(df.values).map(([k,v]:any)=>[k,v[d.i]]))}));
  const all=frames.flatMap((f:any)=>Object.values(f.values) as number[]).filter((v:any)=>v!=null).sort((a:number,b:number)=>a-b),q=(p:number)=>all[Math.round((all.length-1)*p)],range:[number,number]=[q(.05),q(.95)];
  const outline=sketchDistricts(fc,{frame,roughness:.7}),shaded=frames.map((f:any)=>sketchDistricts(fc,{frame,values:f.values,range,seedSalt:f.first,roughness:.7}));
  const cls=classify({kind:'warm',breaks:'quantile',values:all,decimals:0,unit:'days'}),colors=Object.fromEntries(outline.map((d:any)=>[d.lgd,frames.map((f:any)=>cls.color(f.values[d.lgd])??'none')]));
  const iFirst=frames.findIndex((f:any)=>f.label===s.decade_first),iLast=frames.findIndex((f:any)=>f.label===s.decade_last),m=metricFile('temperature','days_tmax_above_p90');
  const SW=1200,SH=150,pad={l:44,r:16,t:18,b:26},x=scaleLinear().domain([m.years[0],m.years[m.years.length-1]]).range([pad.l,SW-pad.r]),ymax=Math.max(...(m.state_mean as number[])),y=scaleLinear().domain([0,ymax*1.08]).range([SH-pad.b,pad.t]).nice(3),pts=m.years.map((yr:number,i:number)=>[x(yr),y(m.state_mean![i] as number)] as [number,number]),pen=roughLine(pts,1951,.35),decadesTicks=m.years.filter((yr:number)=>yr%10===0),penData={years:m.years,mean:m.state_mean,x0:pad.l,x1:SW-pad.r,y0:y.domain()[0],y1:y.domain()[1],top:pad.t,bottom:SH-pad.b},frameMeta=frames.map((f:any)=>({label:f.label,first:f.first,last:f.last})),tally=Object.fromEntries(outline.map((d:any)=>[d.lgd,{name:d.name,a:frames[iFirst]?.values[d.lgd],b:frames[iLast]?.values[d.lgd]}]));
  const legendHtml=legend({class:'census-legend',title:'Unusually hot days a year · decade average',entries:cls.legend,seed:'census'});
  return `<div class="census" data-census data-colors='${JSON.stringify(colors)}' data-frames='${JSON.stringify(frameMeta)}' data-pen='${JSON.stringify(penData)}' data-tally='${JSON.stringify(tally)}' data-labels="${s.decade_first}|${s.decade_last}"><div class="census-map"><p class="census-decade display" aria-live="off" data-decade></p><svg class="sketch census-svg" viewBox="0 0 ${width} ${height}" role="img" aria-label="Maharashtra's districts shaded by unusually hot days, decade by decade from ${frames[0].label} to ${frames[frames.length-1].label}. Darker colour and denser shading mean more hot days."><g class="census-fill">${outline.map((d:any)=>`<path data-lgd="${d.lgd}" d="${d.plain}"/>`).join('')}</g>${shaded.map((ds:any[],k:number)=>`<g class="census-frame" data-frame="${k}"><g id="cf-${k}">${ds.map((d:any)=>d.hatch.length?`<path class="sk-hatch" d="${d.hatch.join(' ')}"/>`:'').join('')}</g></g>`).join('')}<g class="census-outline" id="census-outline">${outline.map((d:any)=>`<g class="sk-d" data-lgd="${d.lgd}"><path class="sk-hit" d="${d.plain}"/><path class="sk-line" d="${d.outline.join(' ')}"/></g>`).join('')}</g></svg><div class="census-tally label" data-tally-card hidden></div><div class="census-ruler"><label class="label" for="census-slider">Decade</label><input id="census-slider" type="range" min="0" max="${frames.length-1}" step="1" value="0" data-slider aria-valuetext="${escapeHtml(frames[0].label)}"/><ol class="census-ticks label" aria-hidden="true">${frames.map((f:any)=>`<li>${escapeHtml(f.label.replace(' · PARTIAL',''))}</li>`).join('')}</ol></div>${legendHtml}</div><div class="census-lines">${slotHtml}</div><figure class="census-strip"><svg viewBox="0 0 ${SW} ${SH}" preserveAspectRatio="none" role="img" aria-label="Unusually hot days, 35-district average, ${m.years[0]} to ${m.years[m.years.length-1]}."><defs><clipPath id="pen-clip"><rect x="0" y="0" width="${SW}" height="${SH}" data-pen-clip/></clipPath></defs><rect class="strip-band" x="${x(1991)}" y="${pad.t}" width="${x(2020)-x(1991)}" height="${SH-pad.t-pad.b}"/>${y.ticks(3).map((t:number)=>`<g><line class="trend-grid" x1="${pad.l}" x2="${SW-pad.r}" y1="${y(t)}" y2="${y(t)}"/><text class="trend-tick" x="${pad.l-8}" y="${y(t)+3}" text-anchor="end">${t}</text></g>`).join('')}<line class="trend-axis" x1="${pad.l}" x2="${SW-pad.r}" y1="${SH-pad.b}" y2="${SH-pad.b}"/>${decadesTicks.map((t:number)=>`<g><line class="trend-axis" x1="${x(t)}" x2="${x(t)}" y1="${SH-pad.b}" y2="${SH-pad.b+5}"/><text class="trend-tick" x="${x(t)}" y="${SH-6}" text-anchor="middle">${t}</text></g>`).join('')}<path class="strip-pen" d="${pen}" clip-path="url(#pen-clip)"/><g class="strip-nib" data-pen-nib><circle r="4"/><line x1="0" y1="-5" x2="7" y2="-16"/></g></svg><figcaption class="label soft">Days a year above the 1991–2020 90th percentile · 35-district average · shaded band = 1991–2020 normal</figcaption></figure></div>`;
};
const pageStats = stats();
// BN-DASH: the Atlas (MAP.md). Controls on the left page, the map in the
// middle, the district panel in the right margin, the year ruler below.
// Atlas interactions and URL state are implemented in this page.

const s = stats();
const ds = districts();
const pageTitle = "Atlas";
const pageDescription = "District-level climate records for Maharashtra: pick a measure, move through the years, open any district.";

---
<!doctype html>
<html lang="en" data-base={BASE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle === 'Bharatnomy' ? pageTitle : `${pageTitle} · Bharatnomy`}</title>
    <meta name="description" content={pageDescription} />
    
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#F2F3EF" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="atlas-page" data-base={BASE}>
    <a class="skip" href="#main">Skip to content</a>
    <Navbar code="BN-ATLAS" coordsText={coords(s.state_centroid[0], s.state_centroid[1])} coordsLabel="STATE 01 · MAHARASHTRA" />
    <main id="main">

  <div class="atlas" data-atlas data-tab="measure" data-metrics={JSON.stringify(METRICS)} data-datasets={JSON.stringify(DATASETS)}>
    <header class="atlas-head bleed bleed-clm">
      <h1 class="display t-mega atlas-title">ATLAS</h1>
      <div class="atlas-intro">
        <Fragment set:html={sticker("BN-DASH · MAHARASHTRA · DISTRICTS", {tone:"ink", seed:"atlas"})} />
        <p class="t-lead">District-level climate records for Maharashtra. Pick a measure, move through the years, open any district.</p>
        <p class="soft atlas-india">India, state by state: Maharashtra is the first state in the Atlas. More states join as their data clears our verification standard.</p>
      </div>
    </header>

    <p class="atlas-error" data-atlas-error hidden><a class="btn" href={u("/datasets")}><span>The map could not load. The data is still available on the datasets page.</span><span class="btn-arrow" aria-hidden="true">→</span></a></p>

    <div class="atlas-body">
      <!-- ============================================== controls (left page) -->
      <aside class="atlas-controls atlas-pane" data-pane="measure" aria-label="Map controls">
        <div class="ctl">
          <label class="label" for="atlas-state">State</label>
          <select id="atlas-state" disabled><option>Maharashtra</option></select>
        </div>

        <div class="ctl">
          <p class="label" id="ds-label">Dataset</p>
          <div class="ds-tabs" role="tablist" aria-labelledby="ds-label">
            {DATASETS.map((d) => <button type="button" role="tab" class="ds-tab" data-ds={d.slug} aria-selected="false">{d.slug === 'temperature' ? 'Temperature' : 'Rainfall'}</button>)}
          </div>
        </div>

        <fieldset class="ctl">
          <legend class="label">Measure</legend>
          <ul class="metric-list">
            {METRICS.map((m) => (
              <li data-metric-item data-dataset={m.dataset} hidden={m.dataset !== 'temperature'}>
                <label class="metric">
                  <input type="radio" name="metric" value={m.id} />
                  <span class="metric-name">{m.label}</span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
        <aside class="mnote ctl-help" data-help aria-live="polite"></aside>

        <fieldset class="ctl">
          <legend class="label">View</legend>
          <div class="seg">
            <label><input type="radio" name="view" value="year" /> <span>Single year</span></label>
            <label><input type="radio" name="view" value="decade" /> <span>Decade average</span></label>
            <label><input type="radio" name="view" value="change" /> <span>Change</span></label>
          </div>
          <div class="periods" data-change-periods hidden>
            <p class="soft">Later period minus earlier period.</p>
            <div class="period"><span class="label">Earlier</span><input type="number" data-period="a.0" aria-label="Earlier period, first year" /><span aria-hidden="true">to</span><input type="number" data-period="a.1" aria-label="Earlier period, last year" /></div>
            <div class="period"><span class="label">Later</span><input type="number" data-period="b.0" aria-label="Later period, first year" /><span aria-hidden="true">to</span><input type="number" data-period="b.1" aria-label="Later period, last year" /></div>
          </div>
        </fieldset>

        <fieldset class="ctl">
          <legend class="label">Classes</legend>
          <div class="seg">
            <label><input type="radio" name="classes" value="quantile" /> <span>Quantile (5)</span></label>
            <label><input type="radio" name="classes" value="equal" /> <span>Equal interval (5)</span></label>
          </div>
          <p class="soft small" data-classes-note hidden>Diverging measures are always symmetric around zero.</p>
        </fieldset>

        <div class="ctl ctl-toggles">
          <button type="button" class="btn" data-toggle="sketch" aria-pressed="false"><span>Sketch view</span></button>
          <button type="button" class="btn" data-toggle="table" aria-pressed="false"><span>Show as table</span></button>
          <button type="button" class="btn" data-png><span>Save map as PNG</span><span class="btn-arrow" aria-hidden="true">↓</span></button>
        </div>
      </aside>

      <!-- ===================================================== the map -->
      <section class="atlas-stage" aria-label="Map">
        <p class="atlas-maptitle"><span class="display" data-map-title></span> <span class="label atlas-period" data-map-period></span></p>
        <div class="atlas-mapwrap">
          <div class="atlas-map" data-map tabindex="-1"></div>
          <div class="atlas-sketch" data-sketch hidden></div>
          <div class="atlas-tablewrap table-wrap" data-table hidden></div>
          <div class="atlas-tip label" data-tip hidden></div>
          <figure class="legend atlas-legend" data-legend></figure>
        </div>
        <aside class="mnote atlas-caveat"><span class="label mnote-label">Read with care</span>Figures are district averages of IMD's gridded data on 2011 boundaries. They are best compared across years and districts, not with a single weather station. Thane includes today's Palghar.</aside>
        <p class="source label" data-source></p>
        <p class="visually-hidden" aria-live="polite" data-sr></p>
      </section>

      <!-- ======================================= district panel (margin) -->
      <aside class="atlas-panel atlas-pane" data-pane="district" aria-label="District">
        <div class="atlas-search">
          <label class="label" for="district-search">Find a district</label>
          <input id="district-search" type="search" list="district-list" autocomplete="off" placeholder="Type a name, then Enter" />
          <datalist id="district-list">{ds.map((d) => <option value={d.name} />)}</datalist>
        </div>
        <div class="dp card-flat" data-panel>
          <div class="panel-empty"><p class="t-lead">Select a district on the map, or search for one.</p></div>
        </div>
      </aside>

      <div class="atlas-pane atlas-pane-table" data-pane="table"><div class="table-wrap" data-table-m></div></div>
    </div>

    <!-- ======================================================= year ruler -->
    <div class="atlas-rulerbar">
      <button type="button" class="btn atlas-play" data-play aria-pressed="false"><span>Play</span></button>
      <div class="ruler" data-ruler>
        <svg viewBox="0 0 1000 64" preserveAspectRatio="none" aria-hidden="true"></svg>
        <div class="ruler-thumb" role="slider" tabindex="0" aria-label="Year" aria-valuemin="1951" aria-valuemax="2024" aria-valuenow="2024"><span>2024</span></div>
      </div>
    </div>

    <nav class="atlas-tabs" aria-label="Atlas sections" role="tablist">
      <button type="button" role="tab" data-tab-btn="measure" aria-selected="true">Measure</button>
      <button type="button" role="tab" data-tab-btn="district" aria-selected="false">District</button>
      <button type="button" role="tab" data-tab-btn="table" aria-selected="false">Table</button>
    </nav>
  </div>

    </main>
    <Footer stats={pageStats} />
