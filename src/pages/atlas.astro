        if ((onA || onB) && !plants) {
            try { plants = await loadPlants(); }
            catch (err) { console.error(err); return; }
            if (ticket !== pending)
                return;
        }
        for (const [A, on, sel] of [[atlas, onA, '[data-legend]'], [s.cmp ? atlasB : null, onB, '[data-legend-b]']]) {
            if (!A)
