            return '';
        const name = byLgd[lgd]?.name;
        const here = plants.features.map((f) => f.properties).filter((p) => p.lgd === lgd).sort((a, b) => b.mw - a.mw);
        if (!here.length)
            return `<p class="soft dp-plants-none">No plants listed in ${esc(name)}.</p>`;
        const color = Object.fromEntries(FUELS);
        return `<section class="dp-plants" aria-label="Plants in ${esc(name)}"><p class="label">Plants · ${here.length}</p><ol class="dp-plant-list">${here.map((p) => `<li><span class="legend-dot" style="background:${color[p.fuel] ?? '#fff'}"></span><span class="dp-plant-name">${esc(p.name)}</span><span class="mono soft">${esc(p.fuel)} · ${Number(p.mw).toLocaleString('en-IN', { maximumFractionDigits: 1 })} MW</span></li>`).join('')}</ol></section>`;
    }
    /* ---------------------------------------------------------- controls ---- */
    function syncControls() {
        $$('[data-ds]').forEach((b) => { const on = b.dataset.ds === s.dataset; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; });
        $$('[data-metric-item]').forEach((li) => { li.hidden = li.dataset.dataset !== s.dataset; });
