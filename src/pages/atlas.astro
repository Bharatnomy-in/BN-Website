const census = (slotHtml: string, o:any={}) => {
  const width=o.width??640,height=o.height??470,s=stats(),fc=districtsGeo(),frame=frameFor(stateGeo(),width,height,10),df=decadeFrames();
  const idx=df.decades.map((d:any,i:number)=>({...d,i})).filter((d:any,k:number,all:any[])=>d.complete||k===all.length-1).filter((d:any)=>d.start>=1960);
  const frames=idx.map((d:any)=>({label:d.complete?d.label:`${d.first}–${d.last} · PARTIAL`,first:d.first,last:d.last,i:d.i,values:Object.fromEntries(Object.entries(df.values).map(([k,v]:any)=>[k,v[d.i]]))}));
