---
interface Props {
  stats?: {
    data?: {
      repo: string;
      commit: string;
      short: string;
      built: string;
    };
  };
}

const { stats } = Astro.props;
const data = stats?.data;
const stampDate = (iso: string) => {
  const date = new Date(`${iso}T00:00:00Z`);
  return date.toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).toUpperCase();
};
const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const u = (p: string) => (/^(https?:|mailto:|#|data:)/.test(p) ? p : BASE + (p.startsWith('/') ? p : `/${p}`));
---
<footer class="back">
  <div class="back-inner">
    <p class="back-mark display" aria-hidden="true">BHARATNOMY</p>
    <div class="back-cols">
      <nav aria-label="Footer">
        <div class="back-group">
          <p class="label soft">Read</p>
          <ul class="mono">
            <li><a href={u('/research')}>Research</a></li>
            <li><a href={u('/datasets')}>Datasets</a></li>
            <li><a href={u('/atlas')}>Atlas</a></li>
            <li><a href={u('/dashboard')}>Dashboard</a></li>
          </ul>
        </div>
        <div class="back-group">
          <p class="label soft">About us</p>
          <ul class="mono">
            <li><a href={u('/about')}>About</a></li>
            <li><a href={u('/careers')}>Careers</a></li>
          </ul>
        </div>
      </nav>
      <div class="back-text">
        <p><a href="mailto:namaste@bharatnomy.com">namaste@bharatnomy.com</a>. We only write when there is something real to share.</p>
        <p>Independent, evidence-based research for citizens and market actors.</p>
        <p class="mono soft">© 2026 Bharatnomy. We maintain no partisan political affiliation.</p>
        {data && (
          <p class="stamp label">
            <a href={`${data.repo}/tree/${data.commit}`} class="stamp-link">DATA @ {data.short}</a> · BUILT {stampDate(data.built)}
          </p>
        )}
      </div>
    </div>
  </div>
</footer>
<style is:global>
/* ------------------------------------------------------------------ Footer */
.back {
  margin-top: var(--s-9);
  --ink: #F2F3EF; --ink-soft: #D5DCE6; --ink-faint: rgba(242, 243, 239, 0.4); --accent: #F8EED2;
  color: var(--ink);
  background-color: var(--lens-eqt);
  background-image:
    linear-gradient(rgba(242, 243, 239, 0.07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(242, 243, 239, 0.07) 1px, transparent 1px);
  background-size: var(--grid) var(--grid);
  border-top: var(--hair);
  overflow: hidden;
}
.back-inner {
  max-width: var(--page-max); margin-inline: auto; padding: var(--s-9) var(--gutter) 0;
  display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s-5);
}
.back-mark {
  grid-column: 1 / -1; grid-row: 2;
  font-size: min(19vw, 17.5rem); line-height: 0.74; font-weight: 900; letter-spacing: -0.015em;
  margin: var(--s-8) 0 0 -0.04em; padding-bottom: var(--s-6); white-space: nowrap;   /* the whole word shows */
}
.back-cols { grid-column: 7 / 13; grid-row: 1; display: grid; grid-template-columns: auto 1fr; gap: var(--s-8); }
.back-cols nav { flex-direction: column; gap: var(--s-5) !important; }
.back-cols nav { display: flex; gap: var(--s-8); }
.back-group ul { list-style: none; margin: var(--s-2) 0 0; padding: 0; display: grid; gap: 2px; }
.back-group a, .back a { color: var(--ink); }
.back .stamp { border-color: var(--ink); }
.back-text { display: grid; gap: var(--s-3); font-size: var(--t-small); max-width: 46ch; }
.stamp { display: inline-block; justify-self: start; border: var(--hair); padding: 5px 9px; transform: rotate(-1.5deg); margin-top: var(--s-2); }
.stamp-link { color: inherit; text-decoration: none; }
.stamp-link:hover { text-decoration: underline; }
@media (max-width: 899px) {
  .back-inner { grid-template-columns: 1fr; padding-top: var(--s-7); }
  .back-cols { grid-column: 1; grid-template-columns: 1fr; gap: var(--s-6); }
  .back-cols nav { flex-direction: row; gap: var(--s-8) !important; }
  .back-mark { grid-column: 1; font-size: 19.5vw; margin-top: var(--s-7); }
}


</style>
